<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Framework CSS -->
    <link rel="stylesheet" href="/user/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/user/assets/css/animate.min.css">
    <link rel="stylesheet" href="/user/assets/css/boxicons.min.css">
    <link rel="stylesheet" href="/user/assets/css/flaticon.css">
    <link rel="stylesheet" href="/user/assets/css/magnific-popup.min.css">
    <link rel="stylesheet" href="/user/assets/css/nice-select.min.css">
    <link rel="stylesheet" href="/user/assets/css/slick.min.css">
    <link rel="stylesheet" href="/user/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="/user/assets/css/meanmenu.min.css">
    <link rel="stylesheet" href="/user/assets/css/rangeSlider.min.css">
    <link rel="stylesheet" href="/user/assets/css/style.css">
    <link rel="stylesheet" href="/user/assets/css/responsive.css">

    <!-- Attiro Design System (loaded after framework to override) -->
    <link rel="stylesheet" href="/user/assets/css/attiro-variables.css">
    <link rel="stylesheet" href="/user/assets/css/attiro-base.css">
    <link rel="stylesheet" href="/user/assets/css/attiro-components.css">

    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

    <!-- JS Libraries (loaded once) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <title>Attiro Fashions</title>
    <link rel="icon" type="image/png" href="/user/assets/img/favicon.png">

    <!-- Header Overrides -->
    <style>
    /* ── Announcement Bar ── */
    .attiro-topbar {
        background-color: var(--bg-warm);
        padding: 8px 0;
        font-size: var(--text-xs);
        color: var(--text-primary);
        text-align: center;
        letter-spacing: 0.04em;
    }

    .attiro-topbar .topbar-links {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: var(--space-lg);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .attiro-topbar .topbar-links a {
        color: var(--text-primary);
        font-size: var(--text-xs);
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        transition: color var(--transition-fast);
    }

    .attiro-topbar .topbar-links a:hover {
        color: var(--accent);
    }

    /* ── Main Navbar ── */
    .navbar-area,
    .navbar-area.header-sticky,
    .navbar-area.header-sticky.is-sticky,
    .xton-nav,
    .xton-responsive-nav,
    .xton-responsive-menu,
    .xton-nav .container-fluid,
    .xton-nav .navbar,
    .xton-nav .navbar-collapse {
        background-color: var(--bg-warm, #DDD3CB) !important;
        background: var(--bg-warm, #DDD3CB) !important;
    }

    .navbar-area {
        border-bottom: 1px solid rgba(150, 117, 101, 0.2) !important;
        box-shadow: none !important;
        transition: all 0.3s ease;
    }

    .navbar-area.header-sticky.is-sticky {
        box-shadow: 0 2px 10px rgba(53, 31, 22, 0.08) !important;
    }

    .xton-nav .navbar {
        padding-top: 8px !important;
        padding-bottom: 8px !important;
    }

    .xton-nav .navbar .navbar-brand .main-logo,
    .xton-responsive-menu .logo .main-logo {
        max-height: 38px;
    }

    /* Brand Text Fallback */
    .attiro-brand {
        font-family: var(--font-display);
        font-size: 24px;
        font-weight: 700;
        color: var(--text-heading);
        letter-spacing: 0.05em;
        text-decoration: none;
    }

    .attiro-brand:hover {
        color: var(--text-heading);
    }

    /* Nav Links in Middle Part — Compact, Closer Spacing & Palette Matched */
    .xton-nav .navbar .navbar-nav {
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
        margin-left: auto !important;
        margin-right: auto !important;
    }

    .xton-nav .navbar .navbar-nav .nav-item a.nav-link {
        font-family: var(--font-body) !important;
        font-size: 15px !important;
        font-weight: 500 !important;
        color: var(--text-primary, #351F16) !important;
        padding: 8px 14px !important;
        margin: 0 !important;
        border-radius: 4px;
        letter-spacing: 0.2px;
        transition: all var(--transition-fast);
    }

    .xton-nav .navbar .navbar-nav .nav-item a.nav-link:hover,
    .xton-nav .navbar .navbar-nav .nav-item a.nav-link.active {
        color: var(--accent, #967565) !important;
        background-color: rgba(150, 117, 101, 0.12) !important;
        font-weight: 600 !important;
    }

    /* Cart Badge */
    .cart-btn a {
        position: relative;
        color: var(--text-primary);
        font-size: 22px;
        transition: color var(--transition-fast);
    }

    .cart-btn a:hover {
        color: var(--accent);
    }

    .cart-btn a span {
        position: absolute;
        top: -6px;
        right: -10px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: var(--radius-full);
        background-color: var(--accent);
        color: var(--white);
        font-size: 10px;
        font-weight: 600;
        font-family: var(--font-body);
    }

    /* Top Header Links */
    .top-header {
        background-color: var(--bg-warm, #DDD3CB) !important;
        border-bottom: 1px solid rgba(150, 117, 101, 0.15) !important;
        padding: 6px 0 !important;
    }

    .header-contact-info li,
    .header-top-menu li a {
        color: var(--text-primary) !important;
        font-family: var(--font-body) !important;
        font-size: var(--text-xs) !important;
        font-weight: 500 !important;
    }

    .header-top-menu li a:hover {
        color: var(--accent) !important;
    }

    .header-top-menu li a i {
        color: var(--accent);
        margin-right: 4px;
    }
    </style>
</head>

<body>
    <!-- Start Top Header Area -->
    <div class="top-header">
        <div class="container-fluid">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-6 col-md-12">
                    <ul class="header-contact-info">
                        <li>Welcome to Attiro Fashions — Elevate Your Style</li>
                    </ul>
                </div>

                <div class="col-lg-6 col-md-12">
                    <ul class="header-top-menu">
                        <% if (locals.session.isAuth) { %>
                            <li><a href="/profile"><i class='bx bxs-user'></i> My Account</a></li>
                            <li><a href="/wishlist"><i class='bx bx-heart'></i> Wishlist</a></li>
                        <% } else { %>
                            <li><a href="/login"><i class='bx bx-log-in'></i> Login</a></li>
                        <% } %>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <!-- End Top Header Area -->

    <!-- Start Navbar Area -->
    <div class="navbar-area">
        <div class="xton-responsive-nav">
            <div class="container">
                <div class="xton-responsive-menu">
                    <div class="logo">
                        <a href="/">
                            <img src="/user/assets/img/logo.png" class="main-logo" alt="Attiro Fashions">
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="xton-nav">
            <div class="container-fluid">
                <nav class="navbar navbar-expand-md navbar-light">
                    <a class="navbar-brand" href="/">
                        <img src="/user/assets/img/logo.png" class="main-logo" alt="Attiro Fashions">
                    </a>

                    <div class="collapse navbar-collapse mean-menu">
                        <ul class="navbar-nav">
                            <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
                            <li class="nav-item"><a href="/shop" class="nav-link">Shop</a></li>
                            <li class="nav-item"><a href="/about" class="nav-link">About</a></li>
                            <li class="nav-item"><a href="/contact" class="nav-link">Contact</a></li>
                        </ul>

                        <div class="others-option">
                            <% if (locals.session.isAuth) { %>
                                <div class="option-item">
                                    <div class="cart-btn">
                                        <a href="/cart"><i class='bx bx-shopping-bag'></i><span><%= cartItem %></span></a>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>
    <!-- End Navbar Area -->

    <!-- Start Sticky Navbar Area -->
    <div class="navbar-area header-sticky">
        <div class="xton-nav">
            <div class="container-fluid">
                <nav class="navbar navbar-expand-md navbar-light">
                    <a class="navbar-brand" href="/">
                        <img src="/user/assets/img/logo.png" alt="Attiro Fashions">
                    </a>

                    <div class="collapse navbar-collapse mean-menu">
                        <ul class="navbar-nav">
                            <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
                            <li class="nav-item"><a href="/shop" class="nav-link">Shop</a></li>
                            <li class="nav-item"><a href="/about" class="nav-link">About</a></li>
                            <li class="nav-item"><a href="/contact" class="nav-link">Contact</a></li>
                        </ul>

                        <div class="others-option">
                            <% if (locals.session.isAuth) { %>
                                <div class="option-item">
                                    <div class="cart-btn">
                                        <a href="/cart"><i class='bx bx-shopping-bag'></i><span><%= cartItem %></span></a>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </div>

    <!-- Active Nav Script -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
        const currentPath = window.location.pathname;
        
        navLinks.forEach(link => {
            link.classList.remove('active');
            if (link.getAttribute('href') === currentPath) {
                link.classList.add('active');
            }
        });

        navLinks.forEach(link => {
            link.addEventListener('click', function() {
                navLinks.forEach(l => l.classList.remove('active'));
                this.classList.add('active');
            });
        });
    });
    </script>
