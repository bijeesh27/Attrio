<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/user/assets/css/profilestyle.css" />

<style>
  .transactions-container {
    padding: 0;
  }

  .transactions-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-color);
  }

  .transactions-title {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--text-color);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .back-link {
    color: var(--accent-color);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--text-color);
  }

  .transaction-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .transaction-item {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background-color: #FFFFFF;
    transition: all 0.2s ease;
  }

  .transaction-item:hover {
    background-color: #FAF8F6;
    border-color: var(--accent-color);
  }

  .transaction-icon {
    margin-right: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: var(--bg-warm);
  }

  .transaction-item.transaction-positive .transaction-icon {
    background-color: #eaf3ec;
    color: #4B7252;
  }

  .transaction-item.transaction-negative .transaction-icon {
    background-color: #fbedeb;
    color: #A34836;
  }

  .transaction-icon i {
    font-size: 20px;
  }

  .transaction-content {
    flex-grow: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .transaction-type {
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: 4px;
    font-size: 0.95rem;
  }

  .transaction-type a {
    color: var(--accent-color);
    text-decoration: none;
  }

  .transaction-date {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .transaction-amount {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .transaction-positive .transaction-amount {
    color: #4B7252;
  }

  .transaction-negative .transaction-amount {
    color: #A34836;
  }

  .no-transactions {
    text-align: center;
    padding: 50px 20px;
    background-color: #FFFFFF;
    border-radius: 10px;
    color: var(--text-muted);
    border: 1px solid var(--border-color);
  }

  /* Pagination */
  .pagination-numbers {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 30px 0 10px;
  }

  .pagination-number, .pagination-arrow {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    background-color: #FFFFFF;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.88rem;
    transition: all 0.2s ease;
  }

  .pagination-number:hover, .pagination-arrow:hover {
    background-color: var(--bg-warm);
    border-color: var(--accent-color);
    color: var(--text-color);
  }

  .pagination-number.active {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
    color: #FFFFFF;
    font-weight: 600;
  }

  .pagination-arrow.disabled {
    opacity: 0.4;
    pointer-events: none;
  }
</style>

<body>
  <div class="dashboard-container">
    <!-- Account Menu -->
    <div class="account-tabs-menu">
      <ul>
        <li><a href="/profile"><i class="bx bxs-user"></i>Profile</a></li>
        <li><a href="/orders"><i class="bx bxs-shopping-bag"></i> Orders</a></li>
        <li><a href="/address"><i class="bx bxs-map"></i> Addresses</a></li>
        <li><a href="/wallet" class="active"><i class="bx bxs-wallet"></i> Wallet</a></li>
        <li><a href="/changenewpassword"><i class="bx bx-lock-alt"></i> Change Password</a></li>
      </ul>
      <div style="margin-top: 40px;">
        <button onclick="logout()" class="logout-button">
          <i class="bx bx-log-out"></i> Logout
        </button>
      </div>
    </div>

    <!-- Transactions Content -->
    <div class="dashboard-content">
      <div class="address-section">
        <div class="transactions-header">
          <h2 class="transactions-title">
            <i class="bx bx-history" style="color: var(--accent-color);"></i>
            Transaction Ledger
          </h2>
          <a href="/wallet" class="back-link">
            <i class="bx bx-arrow-back"></i> Back to Wallet
          </a>
        </div>

        <div class="transaction-list">
          <% if (wallet && wallet.transaction && wallet.transaction.length > 0) { %>
            <% wallet.transaction.forEach(transaction => { 
              const isCredit = ['Refund', 'Credit', 'Referral', 'Razorpay'].includes(transaction.transactionsMethod);
              const transactionClass = isCredit ? 'transaction-positive' : 'transaction-negative';
              const transactionIcon = isCredit ? 'bx-arrow-from-left' : 'bx-arrow-from-right';

              let transactionDescription = transaction.transactionsMethod;
              switch (transaction.transactionsMethod) {
                case 'Payment': transactionDescription = 'Product Purchase'; break;
                case 'Refund': transactionDescription = 'Order Refund'; break;
                case 'Razorpay': transactionDescription = 'Added via Razorpay'; break;
                case 'Referral': transactionDescription = 'Referral Reward'; break;
                case 'Credit': transactionDescription = 'Wallet Credit'; break;
              }
            %>
              <div class="transaction-item <%= transactionClass %>">
                <div class="transaction-icon">
                  <i class="bx <%= transactionIcon %>"></i>
                </div>
                <div class="transaction-content">
                  <div>
                    <div class="transaction-type">
                      <%= transactionDescription %>
                      <% if (transaction.orderId && transaction.orderId.orderNumber) { %>
                        (<a href="/orderdetails/<%= transaction.orderId._id %>">#<%= transaction.orderId.orderNumber %></a>)
                      <% } %>
                    </div>
                    <span class="transaction-date">
                      <%= new Date(transaction.date).toLocaleDateString('en-US', { 
                        month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit'
                      }) %>
                    </span>
                  </div>
                  <div class="transaction-amount">
                    <%= isCredit ? '+' : '-' %>₹<%= transaction.amount.toFixed(2) %>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="no-transactions">
              <i class="bx bx-receipt mb-2" style="font-size: 2.5rem; color: var(--accent-color);"></i>
              <p>No transactions found in your records.</p>
            </div>
          <% } %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="text-center">
            <div class="pagination-numbers">
              <a href="?page=<%= currentPage > 1 ? currentPage - 1 : 1 %>" class="pagination-arrow prev <%= currentPage === 1 ? 'disabled' : '' %>">
                <i class="bx bx-chevron-left"></i>
              </a>

              <% 
                const maxPagesToShow = 5; 
                let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2)); 
                let endPage = Math.min(totalPages, startPage + maxPagesToShow - 1); 
                if (endPage - startPage + 1 < maxPagesToShow) { 
                  startPage = Math.max(1, endPage - maxPagesToShow + 1); 
                } 
              %>
              
              <% if (startPage > 1) { %>
                <a href="?page=1" class="pagination-number">1</a>
                <% if (startPage > 2) { %><span class="px-1 text-muted">...</span><% } %>
              <% } %>
              
              <% for(let i = startPage; i <= endPage; i++) { %>
                <% if(i === currentPage) { %>
                  <span class="pagination-number active"><%= i %></span>
                <% } else { %>
                  <a href="?page=<%= i %>" class="pagination-number"><%= i %></a>
                <% } %>
              <% } %>
              
              <% if (endPage < totalPages) { %>
                <% if (endPage < totalPages - 1) { %><span class="px-1 text-muted">...</span><% } %>
                <a href="?page=<%= totalPages %>" class="pagination-number"><%= totalPages %></a>
              <% } %>

              <a href="?page=<%= currentPage < totalPages ? currentPage + 1 : totalPages %>" class="pagination-arrow next <%= currentPage === totalPages ? 'disabled' : '' %>">
                <i class="bx bx-chevron-right"></i>
              </a>
            </div>

            <div class="text-muted" style="font-size: 0.85rem;">
              Showing page <%= currentPage %> of <%= totalPages %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    function logout() {
      Swal.fire({
        title: 'Sign Out',
        text: 'Do you want to continue to logout?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#4B4C3C',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Logout',
        cancelButtonText: 'Cancel',
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = '/logout';
        }
      });
    }
  </script>

<%- include('../partials/user/footer') %>
