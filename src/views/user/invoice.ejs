<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/user/assets/img/favicon.png">
    
    <title>Attrio Fashions - Invoice #<%= order.orderNumber %></title>
    <style>
        :root {
            --bg-primary: #F4F4F4;
            --bg-warm: #DDD3CB;
            --accent: #967565;
            --btn-primary: #4B4C3C;
            --text-primary: #351F16;
            --border-color: #DDD3CB;
        }

        body {
            font-family: 'Inter', -apple-system, sans-serif;
            margin: 0;
            padding: 30px 15px;
            color: var(--text-primary);
            background-color: var(--bg-primary);
        }

        .download-container {
            max-width: 820px;
            margin: 0 auto 20px auto;
            text-align: right;
        }

        .download-btn {
            padding: 10px 22px;
            background-color: var(--btn-primary);
            color: #FFFFFF;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 500;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.92rem;
            transition: all 0.2s ease;
        }

        .download-btn:hover {
            background-color: #37382B;
            color: #FFFFFF;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(75, 76, 60, 0.2);
        }

        .invoice-container {
            max-width: 820px;
            margin: 0 auto;
            background-color: #FFFFFF;
            padding: 45px 50px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 20px rgba(53, 31, 22, 0.05);
        }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 35px;
            border-bottom: 2px solid var(--bg-warm);
            padding-bottom: 25px;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: 1px;
        }

        .logo span {
            color: var(--accent);
            font-style: italic;
        }

        .company-info {
            text-align: right;
            font-size: 0.88rem;
            color: #605249;
            line-height: 1.5;
        }

        .company-info p {
            margin: 0;
        }

        .invoice-title {
            text-align: center;
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            margin: 10px 0 30px;
            color: var(--text-primary);
            letter-spacing: 0.5px;
        }

        .invoice-details {
            display: flex;
            justify-content: space-between;
            margin-bottom: 35px;
            gap: 30px;
        }

        .client-info, .payment-info {
            width: 48%;
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .client-info h3, .payment-info h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 12px;
            color: var(--text-primary);
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 6px;
        }

        .client-info address {
            font-style: normal;
            margin: 0 0 8px;
            color: #605249;
        }

        .payment-info p {
            margin: 0 0 6px;
            color: #605249;
        }

        .payment-info p strong {
            color: var(--text-primary);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 25px 0;
            font-size: 0.92rem;
        }

        th {
            background-color: var(--bg-warm);
            color: var(--text-primary);
            text-align: left;
            padding: 12px 14px;
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
        }

        td {
            padding: 14px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
            vertical-align: middle;
        }

        .text-right {
            text-align: right;
        }

        .total-row {
            font-weight: 700;
            background-color: #FAF8F6;
            font-size: 1rem;
        }

        .total-row td {
            border-top: 2px solid var(--border-color);
            border-bottom: 2px solid var(--border-color);
        }

        .status-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-pending { background-color: #fbf2e5; color: #A36B28; }
        .status-shipped { background-color: #edf2f7; color: #3d5a80; }
        .status-delivered { background-color: #eaf3ec; color: #4B7252; }
        .status-cancelled { background-color: #fbedeb; color: #A34836; }
        .status-returned { background-color: #e2ded9; color: #605249; }

        .terms {
            margin-top: 35px;
            padding: 16px 20px;
            background-color: #FAF8F6;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 0.82rem;
            color: #7c7267;
            line-height: 1.5;
        }

        .terms h4 {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: var(--text-primary);
        }

        .terms p {
            margin: 0 0 4px;
        }

        .footer {
            margin-top: 40px;
            text-align: center;
            color: #8c8279;
            font-size: 0.82rem;
            border-top: 1px solid var(--border-color);
            padding-top: 20px;
        }

        @media print {
            body { background-color: #fff; padding: 0; }
            .invoice-container { box-shadow: none; border: none; padding: 0; }
            .download-container { display: none; }
        }
    </style>
</head>
<body>
    <div class="download-container">
        <a href="/invoice/<%= order._id %>" id="downloadBtn" class="download-btn">
            <i class="bi bi-file-earmark-arrow-down"></i> Download Invoice PDF
        </a>
    </div>
    
    <div class="invoice-container" id="invoice">
        <div class="invoice-header">
            <div>
                <div class="logo">ATTIRO <span>Fashions</span></div>
                <small class="text-muted" style="letter-spacing: 0.5px;">Artisan Tailoring & Contemporary Wear</small>
            </div>
            <div class="company-info">
                <p><strong><%= company.name || 'Attrio Fashions Pvt. Ltd.' %></strong></p>
                <p><%= company.address %></p>
                <p>Phone: <%= company.phone %></p>
                <p>Email: <%= company.email %></p>
            </div>
        </div>

        <div class="invoice-title">TAX INVOICE #<%= order.orderNumber %></div>

        <div class="invoice-details">
            <div class="client-info">
                <h3>Billed To:</h3>
                <p><strong><%= order.userId?.username %></strong></p>
                <% if(address && address.length > 0) { %>
                    <address>
                        <%= address[0].houseName %><br>
                        <% if(address[0].street) { %><%= address[0].street %><br><% } %>
                        <%= address[0].city %>, <%= address[0].state %> <%= address[0].pincode %><br>
                        <%= address[0].country || 'India' %><br>
                        Phone: <%= address[0].number %>
                    </address>
                <% } %>
                <p>Email: <%= order.userId?.email %></p>
            </div>

            <div class="payment-info">
                <h3>Order Information:</h3>
                <p><strong>Order ID:</strong> #<%= order.orderNumber %></p>
                <p><strong>Order Date:</strong> <%= new Date(order.createdAt).toLocaleDateString() %></p>
                <% if (order.deliveryDate) { %>
                    <p><strong>Delivery Date:</strong> <%= new Date(order.deliveryDate).toLocaleDateString() %></p>
                <% } %>
                <p><strong>Payment Method:</strong> <%= order.paymentMethod %></p>
                <p><strong>Payment Status:</strong> <%= order.paymentStatus %></p>
                <p><strong>Order Status:</strong> 
                    <span class="status-badge status-<%= order.orderStatus?.toLowerCase() %>">
                        <%= order.orderStatus %>
                    </span>
                </p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th width="42%">Product</th>
                    <th width="12%">Size</th>
                    <th width="10%">Qty</th>
                    <th width="18%" class="text-right">Unit Price</th>
                    <th width="18%" class="text-right">Total</th>
                </tr>
            </thead>
            <tbody>
                <% order.orderedItem.forEach(function(item) { %>
                <tr>
                    <td>
                        <strong><%= item.productId?.name %></strong>
                        <% if (item.productStatus && item.productStatus !== "Pending") { %>
                            <br><small class="status-badge status-<%= item.productStatus.toLowerCase().replace(' ', '-') %>">
                                <%= item.productStatus %>
                            </small>
                        <% } %>
                    </td>
                    <td><%= item.size %></td>
                    <td><%= item.quantity %></td>
                    <td class="text-right">₹<%= item.productPrice.toFixed(2) %></td>
                    <td class="text-right">₹<%= item.totalProductPrice.toFixed(2) %></td>
                </tr>
                <% }); %>
                
                <tr>
                    <td colspan="3"></td>
                    <td class="text-right text-muted">Subtotal:</td>
                    <td class="text-right">₹<%= (order.orderAmount - (order.shippingFee || 0) + (order.couponDiscount || 0)).toFixed(2) %></td>
                </tr>
                <% if (order.couponDiscount && order.couponDiscount > 0) { %>
                <tr>
                    <td colspan="3"></td>
                    <td class="text-right text-success">Coupon Discount:</td>
                    <td class="text-right text-success">-₹<%= order.couponDiscount.toFixed(2) %></td>
                </tr>
                <% } %>
                <% if (order.shippingFee) { %>
                <tr>
                    <td colspan="3"></td>
                    <td class="text-right text-muted">Shipping:</td>
                    <td class="text-right">₹<%= order.shippingFee.toFixed(2) %></td>
                </tr>
                <% } %>
                <tr class="total-row">
                    <td colspan="3"></td>
                    <td class="text-right">Final Amount:</td>
                    <td class="text-right">₹<%= order.orderAmount.toFixed(2) %></td>
                </tr>
            </tbody>
        </table>

        <% if (order.orderStatus === "Returned" || order.orderedItem.some(item => item.productStatus === "Returned" || item.productStatus === "Return Requested" || item.productStatus === "Return Approved")) { %>
        <div class="mt-4">
            <h4 style="font-family: 'Playfair Display', serif; font-size: 1.1rem;">Return Details</h4>
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Status</th>
                        <th>Reason</th>
                        <th>Refunded</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.orderedItem.forEach(function(item) { %>
                    <% if (["Returned", "Return Requested", "Return Approved"].includes(item.productStatus)) { %>
                    <tr>
                        <td><%= item.productId?.name %></td>
                        <td><%= item.returnStatus || item.productStatus %></td>
                        <td><%= item.returnReason || "N/A" %></td>
                        <td><%= item.refunded ? "Processed" : "Pending" %></td>
                    </tr>
                    <% } %>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } %>

        <div class="terms">
            <h4>Terms & Customer Support</h4>
            <p>For any inquiries regarding this order, please contact our support desk at <%= company.supportEmail %> or phone <%= company.supportPhone %>.</p>
            <p>Return policy: Items can be returned within 14 days of delivery in original condition with tags attached.</p>
        </div>

        <div class="footer">
            <p class="m-0">Thank you for curating your wardrobe with Attrio Fashions.</p>
            <p class="m-0 mt-1">www.attirofashions.com</p>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const downloadBtn = document.getElementById('downloadBtn');
            if (downloadBtn) {
                downloadBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const orderNumber = document.querySelector('.invoice-title').textContent.replace('TAX INVOICE #', '').trim();
                    const fileName = `Attrio_Invoice_${orderNumber}.pdf`;
                    const element = document.getElementById('invoice');
                    
                    const opt = {
                        margin: [10, 10, 10, 10],
                        filename: fileName,
                        image: { type: 'jpeg', quality: 0.98 },
                        html2canvas: { scale: 2, useCORS: true },
                        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
                    };
                    
                    html2pdf().set(opt).from(element).save();
                });
            }
        });
    </script>
</body>
</html>
