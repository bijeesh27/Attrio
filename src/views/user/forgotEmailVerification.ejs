<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>Forgot Password — Attiro Fashions</title>
    <link rel="icon" type="image/png" href="/user/assets/img/favicon.png" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/user/assets/css/attiro-variables.css">

    <style>
      :root {
        --bg-primary: #F4F4F4;
        --bg-warm: #DDD3CB;
        --accent: #967565;
        --accent-light: #B89A8C;
        --btn-primary: #4B4C3C;
        --btn-hover: #5D5E4B;
        --text-primary: #351F16;
        --text-heading: #4A2F24;
        --border-color: #E8DED6;
      }

      body, html {
        height: 100%;
        margin: 0;
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-primary);
        color: var(--text-primary);
      }

      .bg-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
        background: radial-gradient(circle at top right, var(--bg-warm), var(--bg-primary));
      }

      .forgot-card {
        background: #FFFFFF;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(53, 31, 22, 0.08);
        padding: 40px;
        width: 100%;
        max-width: 460px;
        text-align: center;
      }

      .lock-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 20px;
        background-color: rgba(150, 117, 101, 0.12);
        color: var(--accent);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
      }

      .forgot-card h2 {
        font-family: 'Playfair Display', serif;
        font-size: 28px;
        color: var(--text-heading);
        margin-bottom: 10px;
      }

      .forgot-card p {
        color: var(--accent);
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 30px;
      }

      .form-group {
        margin-bottom: 20px;
        text-align: left;
      }

      .form-control {
        height: 50px;
        border-radius: 6px;
        border: 1px solid var(--border-color);
        background-color: var(--bg-primary);
        padding: 12px 16px;
        font-size: 14px;
        color: var(--text-primary);
        transition: all 0.25s ease;
      }

      .form-control:focus {
        background-color: #FFFFFF;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(150, 117, 101, 0.15) !important;
        outline: none;
      }

      .submit-btn {
        width: 100%;
        height: 48px;
        background-color: var(--btn-primary);
        color: #FFFFFF;
        border: none;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.03em;
        transition: all 0.25s ease;
        margin-bottom: 20px;
      }

      .submit-btn:hover {
        background-color: var(--btn-hover);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(75, 76, 60, 0.25);
      }

      .back-to-login {
        display: inline-block;
        color: var(--accent);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s;
      }

      .back-to-login:hover {
        color: var(--text-heading);
        text-decoration: underline;
      }

      .flash-message {
        display: flex;
        align-items: center;
        padding: 14px 20px;
        border-radius: 6px;
        font-weight: 500;
        box-shadow: 0 4px 16px rgba(53, 31, 22, 0.1);
        position: fixed;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        max-width: 440px;
        width: 90%;
        z-index: 1050;
        background: #FFFFFF;
      }

      .flash-message svg {
        width: 20px;
        height: 20px;
        margin-right: 12px;
        flex-shrink: 0;
      }

      .error-message {
        color: #A94442;
        border-left: 4px solid #A94442;
      }

      .success-message {
        color: #5B8C5A;
        border-left: 4px solid #5B8C5A;
      }
    </style>
  </head>
  <body>
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="flash-message error-message" id="flash-message">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="feather feather-alert-circle"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span><%= error_msg %></span>
      </div>
    <% } %> 
    
    <% if (success_msg && success_msg.length > 0) { %>
      <div class="flash-message success-message" id="flash-message">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="feather feather-check-circle"
        >
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span><%= success_msg %></span>
      </div>
    <% } %>

    <div class="bg-wrapper">
      <div class="forgot-card">
        <div class="lock-icon">
          <i class="fas fa-lock"></i>
        </div>
        <h2>Forgot Password?</h2>
        <p>
          Enter your email address and we'll send you an OTP to reset your password.
        </p>

        <form class="login-form" action="/verify-fotp" method="post">
          <div class="form-group">
            <input
              type="email"
              class="form-control"
              placeholder="Enter your email address"
              name="email"
              required
            />
          </div>

          <button type="submit" class="submit-btn">
            Send Reset OTP
          </button>

          <div>
            <a href="/login" class="back-to-login">
              <i class="fas fa-arrow-left me-1"></i> Back to Login
            </a>
          </div>
        </form>
      </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
