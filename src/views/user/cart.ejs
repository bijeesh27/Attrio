<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/user/assets/css/cartstyle.css">

<!-- Start Page Title -->
<div class="page-title-area">
  <div class="container">
    <div class="page-title-content">
      <h2>Shopping Cart</h2>
      <ul>
        <li><a href="/">Home</a></li>
        <li>Cart</li>
      </ul>
    </div>
  </div>
</div>
<!-- End Page Title -->

<!-- Start Cart Area -->
<section class="cart-area">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <form>
          <div class="cart-table-container">
            <div class="cart-header d-flex justify-content-between align-items-center">
              <div>
                <h3><i class='bx bx-shopping-bag' style="color: var(--accent);"></i> Shopping Cart</h3>
                <p class="items-count mb-0">
                  <% if (cart && cart.item && cart.item.length > 0) { %>
                    <%= cart.item.length %> item<%= cart.item.length > 1 ? 's' : '' %> in your cart
                  <% } else { %>
                    0 items in your cart
                  <% } %>
                </p>
              </div>
              <% if (cart && cart.item && cart.item.length > 0) { %>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearCart()">
                  <i class="bx bx-trash me-1"></i> Clear Cart
                </button>
              <% } %>
            </div>
            
            <div class="cart-table table-responsive">
              <table class="table table-spaced mb-0">
                <% if (cart && cart.item && cart.item.length > 0) { %>
                <thead>
                  <tr>
                    <th scope="col" style="width: 50px;">#</th>
                    <th scope="col">Product</th>
                    <th scope="col">Price</th>
                    <th scope="col" style="width: 140px;">Quantity</th>
                    <th scope="col">Total</th>
                    <th scope="col" style="width: 60px;"></th>
                  </tr>
                </thead>

                <tbody>
                    <% cart.item.forEach((item, index) => { %>
                      <tr class="cart-item">
                        <td>
                          <span style="color: var(--accent); font-weight: 600;"><%= index + 1 %></span>
                        </td>
                        <td class="product-col">
                          <div class="product-info">
                            <div class="product-image">
                              <a href="/shop-single/<%= item.productId %>">
                                <img src="/<%= item.productId.image[0] %>" alt="<%= item.productId.name %>" class="img-fluid">
                              </a>
                            </div>
                            <div class="product-details">
                              <h4 class="product-title">
                                <a href="/shop-single/<%= item.productId %>"><%= item.productId.name %></a>
                              </h4>
                              <div class="product-meta">
                                <span class="size-badge">Size: <strong><%= item.size %></strong></span>
                                <% if (item.stock == 0) { %>
                                  <span class="stock-badge out-stock">Out of Stock</span>
                                <% } else { %>
                                  <span class="stock-badge in-stock">In Stock</span>
                                <% } %>
                              </div>
                            </div>
                          </div>
                        </td>

                        <td class="price-col">
                          <div>
                            <% if (item.offerPrice) { %>
                              <span style="text-decoration: line-through; color: var(--accent-light); font-size: 13px; display: block;">
                                Rs.<%= item.price.toLocaleString() %>
                              </span>
                              <span style="color: var(--text-heading); font-weight: 700;">
                                Rs.<%= item.offerPrice.toLocaleString() %>
                              </span>
                            <% } else { %>
                              <span style="color: var(--text-heading); font-weight: 700;">Rs.<%= item.price.toLocaleString() %></span>
                            <% } %>
                          </div>
                        </td>

                        <td class="quantity-col">
                          <div class="quantity-selector">
                            <button type="button" class="quantity-btn" onclick="updateQuantity('<%= item.productId._id %>', '<%= item.size %>', -1, '<%= item.stock %>','<%= item.offerPrice %>')">
                              <i class="bx bx-minus"></i>
                            </button>
                            <input type="text" value="<%= item.quantity %>" id="quantity-<%= item.productId._id %>-<%= item.size %>" min="1" max="5" class="quantity-input" readonly>
                            <button type="button" class="quantity-btn" onclick="updateQuantity('<%= item.productId._id %>', '<%= item.size %>', 1, '<%= item.stock %>','<%= item.offerPrice %>')">
                              <i class="bx bx-plus"></i>
                            </button>
                          </div>
                        </td>

                        <td class="total-col">
                          <span class="total" id="total-<%= item.productId._id %>-<%= item.size %>">
                            Rs.<%= item.total.toLocaleString() %>
                          </span>
                        </td>
                        
                        <td class="text-center">
                          <button type="button" class="remove-btn" onclick="removeItem('<%= item.productId._id %>', '<%= item.size %>')" title="Remove item">
                            <i class="bx bx-trash"></i>
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="6">
                        <div class="empty-cart">
                          <div class="empty-cart-icon">
                            <i class="bx bx-shopping-bag"></i>
                          </div>
                          <h3>Your cart is empty</h3>
                          <p>Looks like you haven't added anything to your cart yet.</p>
                          <a href="/shop" class="btn-shop-now">
                            <span>Explore Products</span>
                            <i class="bx bx-right-arrow-alt"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <% if (cart && cart.item && cart.item.length > 0) { %>
              <div class="cart-actions">
                <div class="continue-shopping">
                  <a href="/shop" class="btn-continue">
                    <i class="bx bx-chevron-left"></i>
                    <span>Continue Shopping</span>
                  </a>
                </div>

                <div class="d-flex align-items-center gap-4">
                  <div class="cart-total">
                    <span>Order Total:</span>
                    <span class="total-value">Rs.<%= cart.cartTotal ? cart.cartTotal.toLocaleString() : 0 %></span>
                  </div>

                  <a href="/checkout" class="btn-checkout">
                    <span>Proceed to Checkout</span>
                    <i class="bx bx-right-arrow-alt"></i>
                  </a>
                </div>
              </div>
            <% } %>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
<!-- End Cart Area -->

<script>
function updateQuantity(productId, size, change, stock, offerPrice) {
  const quantityInput = document.getElementById(`quantity-${productId}-${size}`);
  let quantity = parseInt(quantityInput.value) + change;

  if (quantity < 1) {
    quantity = 1;
    return;
  }

  if (stock < quantity && change > 0) {
    Swal.fire({
      title: 'Out of Stock',
      text: 'Sorry, this item is currently out of stock.',
      icon: 'error',
      confirmButtonColor: '#4B4C3C',
    });
    return;
  }

  if (quantity > 5) {
    Swal.fire({
      title: 'Quantity Limit Reached',
      text: 'Sorry, you can only add a maximum of 5 items per product.',
      icon: 'error',
      confirmButtonColor: '#4B4C3C',
    });
    return;
  }

  quantityInput.value = quantity;

  fetch('/cart/update', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      productId: productId,
      size: size,
      quantity: quantity,
      offerPrice: offerPrice
    }),
  })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        const totalElement = document.getElementById(`total-${productId}-${size}`);
        totalElement.textContent = `Rs.${data.itemTotal.toLocaleString()}`;

        const cartTotalElement = document.querySelector('.cart-total .total-value');
        if (cartTotalElement) {
          cartTotalElement.textContent = `Rs.${data.cartTotal.toLocaleString()}`;
        }
      } else {
        Swal.fire({
          title: 'Error',
          text: data.message || 'Failed to update quantity. Please try again.',
          icon: 'error',
          confirmButtonColor: '#4B4C3C',
        });
        if (data.message && data.message.includes("exceeds available stock")) {
          quantityInput.value = data.value.quantity;
        }
      }
    })
    .catch(error => {
      console.error('Error:', error);
      Swal.fire({
        title: 'Error',
        text: 'An error occurred. Please try again.',
        icon: 'error',
        confirmButtonColor: '#4B4C3C',
      });
    });
}

function clearCart() {
  Swal.fire({
    title: 'Are you sure?',
    text: 'Do you want to clear the entire cart?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#4B4C3C',
    cancelButtonColor: '#A94442',
    confirmButtonText: 'Clear',
    cancelButtonText: 'Cancel',
  }).then((result) => {
    if (result.isConfirmed) {
      fetch('/clearcart', {
        method: 'get',
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload();
        } else {
          alert('Failed to clear cart. Please try again.');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
      });
    }
  });
}

function removeItem(productId, size) {
  Swal.fire({
    title: 'Are you sure?',
    text: 'Do you want to remove this item from your cart?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#4B4C3C',
    cancelButtonColor: '#A94442',
    confirmButtonText: 'Remove',
    cancelButtonText: 'Cancel',
  }).then((result) => {
    if (result.isConfirmed) {
      fetch(`/removeItem/${productId}/${size}`, {
        method: 'get',
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload();
        } else {
          alert('Failed to remove item. Please try again.');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
      });
    }
  });
}
</script>

<%- include('../partials/user/footer') %>
