<%- include('../partials/user/header') %>

  <style>
    .order-confirmation-section {
      padding: 70px 0;
      background-color: var(--bg-primary, #F4F4F4);
    }

    .order-confirmation-box {
      background-color: #FFFFFF;
      border-radius: 12px;
      border: 1px solid var(--border-color, #DDD3CB);
      box-shadow: 0 8px 24px rgba(53, 31, 22, 0.05);
      padding: 55px 35px;
      text-align: center;
      max-width: 650px;
      margin: 0 auto;
    }

    .confirmation-icon-wrap {
      width: 80px;
      height: 80px;
      background-color: #eaf3ec;
      color: #4B7252;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      margin-bottom: 24px;
      border: 2px solid #c9dec9;
    }

    .order-confirmation-box h2 {
      font-family: var(--font-heading, 'Playfair Display', serif);
      font-size: 2.1rem;
      color: var(--text-color, #351F16);
      margin-bottom: 12px;
    }

    .order-id-badge {
      display: inline-block;
      padding: 6px 18px;
      background-color: var(--bg-warm, #DDD3CB);
      border-radius: 20px;
      color: var(--text-color, #351F16);
      font-weight: 600;
      font-size: 0.92rem;
      margin-bottom: 20px;
    }

    .confirmation-message {
      font-size: 0.95rem;
      color: var(--text-muted, #7c7267);
      line-height: 1.6;
      margin-bottom: 30px;
    }

    .action-buttons-wrap {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn-attiro-primary {
      background-color: var(--btn-primary, #4B4C3C);
      color: #FFFFFF;
      border: none;
      padding: 12px 28px;
      border-radius: 6px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-attiro-primary:hover {
      background-color: #37382B;
      color: #FFFFFF;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(75, 76, 60, 0.2);
    }

    .btn-attiro-secondary {
      background-color: #FFFFFF;
      color: var(--text-color, #351F16);
      border: 1.5px solid var(--border-color, #DDD3CB);
      padding: 12px 28px;
      border-radius: 6px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-attiro-secondary:hover {
      background-color: var(--bg-warm, #DDD3CB);
      color: var(--text-color, #351F16);
    }
  </style>

  <div class="order-confirmation-section">
    <div class="container">
      <div class="order-confirmation-box">
        <div class="confirmation-icon-wrap">
          <i class="bx bx-check"></i>
        </div>

        <h2>Thank You For Your Order!</h2>

        <div class="order-id-badge">
          Order ID: #<%= order.orderNumber %>
        </div>

        <p class="confirmation-message">
          We've received your order and our artisan team is preparing your garments. A confirmation notification with
          full details has been processed for <strong>
            <%= user.email %>
          </strong>.
        </p>

        <div class="action-buttons-wrap">
          <a href="/shop" class="btn-attiro-primary">
            <i class="bx bx-shopping-bag"></i>
            <span>Continue Shopping</span>
          </a>

          <a href="/orders" class="btn-attiro-secondary">
            <span>View My Orders</span>
            <i class="bx bx-list-ul"></i>
          </a>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/user/footer') %>