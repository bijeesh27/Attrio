<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/user/assets/css/profilestyle.css" />

<body>
  <div class="dashboard-container">
    <!-- Account Menu -->
    <div class="account-tabs-menu">
      <ul>
        <li>
          <a href="/profile"><i class="bx bxs-user"></i>Profile</a>
        </li>
        <li>
          <a href="/orders"><i class="bx bxs-shopping-bag"></i> Orders</a>
        </li>
        <li>
          <a href="/address" class="active"><i class="bx bxs-map"></i> Addresses</a>
        </li>
        <li>
          <a href="/wallet"><i class="bx bxs-wallet"></i>Wallet</a>
        </li>
        <li>
          <a href="/changenewpassword"><i class="bx bx-lock-alt"></i>Change Password</a>
        </li>
      </ul>
      <div style="margin-top: 40px;">
        <button onclick="logout()" class="logout-button">
          <i class="bx bx-log-out"></i> Logout
        </button>
      </div>
    </div>

    <!-- Dashboard Content -->
    <div class="dashboard-content">
      <div class="address-section">
        <div class="section-header">
          <h2>Saved Addresses</h2>
          <a href="/addaddress" class="btn-add">
            <i class="bx bx-plus"></i> Add New Address
          </a>
        </div>

        <% if (addresses && addresses.length > 0) { %>
          <div class="address-grid">
            <% addresses.forEach(address => { %>
              <div class="address-card <%= address.isDefault ? 'default' : '' %>">
                <% if (address.isDefault) { %>
                  <div class="default-badge">Default</div>
                <% } %>
                <span class="address-type"><%= address.saveAs %></span>
                <div class="address-details">
                  <strong><%= address.name %></strong><br>
                  <%= address.addressLine1 || address.street %><br>
                  <% if (address.addressLine2 || address.houseName) { %>
                    <%= address.addressLine2 || address.houseName %><br>
                  <% } %>
                  <%= address.city %>, <%= address.state %> <%= address.postalCode || address.pincode %><br>
                  <%= address.country %><br>
                  <strong>Phone:</strong> <%= address.number %>
                  <% if (address.altPhone) { %>
                    <br><strong>Alt Phone:</strong> <%= address.altPhone %>
                  <% } %>
                </div>
                <div class="address-actions">
                  <a href="/editaddress/<%= address.id || address._id %>" class="btn-address btn-edit">
                    <i class="bx bx-edit"></i> Edit
                  </a>
                  <% if (!address.isDefault) { %>
                    <a href="/setdefaultaddress/<%= address.id || address._id %>" class="btn-address btn-default">
                      <i class="bx bx-check-circle"></i> Default
                    </a>
                    <button class="btn-address btn-delete" onclick="deleteAddress('<%= address.id || address._id %>')">
                      <i class="bx bx-trash"></i> Delete
                    </button>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center p-5 bg-white rounded-3 border" style="border-color: var(--border-color) !important;">
            <i class="bx bx-map-pin mb-3" style="font-size: 3rem; color: var(--accent-color);"></i>
            <h4 style="font-family: var(--font-heading, serif); color: var(--text-color);">No Addresses Saved Yet</h4>
            <p class="text-muted">Add your delivery addresses to enjoy faster checkouts.</p>
            <a href="/addaddress" class="btn-add mt-2">
              <i class="bx bx-plus"></i> Add New Address
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Confirm Delete Modal -->
  <div class="form-overlay" id="deleteConfirmModal">
    <div class="form-container">
      <div class="form-header">
        <h3 style="font-family: var(--font-heading, serif);">Delete Address</h3>
        <div class="form-close" onclick="closeModal('deleteConfirmModal')">
          <i class="bx bx-x"></i>
        </div>
      </div>
      <p style="margin-bottom: 20px; color: var(--text-muted);">Are you sure you want to remove this address? This action cannot be undone.</p>
      <div class="form-actions">
        <button type="button" class="cancel-btn" onclick="closeModal('deleteConfirmModal')">Cancel</button>
        <button type="button" id="confirmDeleteBtn" class="btn-delete" style="padding: 10px 20px; border-radius: 6px;">Delete Address</button>
      </div>
    </div>
  </div>

  <script>
    let addressToDelete = null;

    function logout() {
      Swal.fire({
        title: 'Sign Out',
        text: 'Are you sure you want to log out?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#4B4C3C',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Logout',
        cancelButtonText: 'Cancel',
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = '/logout';
        }
      });
    }

    function closeModal(modalId) {
      document.getElementById(modalId).style.display = 'none';
    }

    function deleteAddress(id) {
      addressToDelete = id;
      document.getElementById('deleteConfirmModal').style.display = 'flex';
      document.getElementById('confirmDeleteBtn').onclick = function() {
        window.location.href = `/deleteaddress/${id}`;
      };
    }

    window.addEventListener('click', function(e) {
      const deleteConfirmModal = document.getElementById('deleteConfirmModal');
      if (e.target === deleteConfirmModal) {
        closeModal('deleteConfirmModal');
      }
    });
  </script>

<%- include('../partials/user/footer') %>
