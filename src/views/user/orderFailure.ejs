<%- include('../partials/user/header') %>

<style>
  .order-failure-section {
    padding: 70px 0;
    background-color: var(--bg-primary, #F4F4F4);
  }

  .order-failure-box {
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 1px solid var(--border-color, #DDD3CB);
    box-shadow: 0 8px 24px rgba(53, 31, 22, 0.05);
    padding: 50px 30px;
    text-align: center;
    max-width: 650px;
    margin: 0 auto;
  }

  .failure-icon-wrap {
    width: 80px;
    height: 80px;
    background-color: #fbedeb;
    color: #A34836;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    margin-bottom: 24px;
    border: 2px solid #f0d5ce;
  }

  .order-failure-box h2 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 2rem;
    color: var(--text-color, #351F16);
    margin-bottom: 12px;
  }

  .failure-message {
    font-size: 0.95rem;
    color: var(--text-muted, #7c7267);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .order-id-badge {
    display: inline-block;
    padding: 6px 16px;
    background-color: var(--bg-warm, #DDD3CB);
    border-radius: 20px;
    color: var(--text-color, #351F16);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 30px;
  }

  .action-buttons-wrap {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
  }

  .btn-retry {
    background-color: var(--btn-primary, #4B4C3C);
    color: #FFFFFF;
    border: none;
    padding: 12px 28px;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .btn-retry:hover {
    background-color: #37382B;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(75, 76, 60, 0.2);
  }

  .btn-orders {
    background-color: #FFFFFF;
    color: var(--text-color, #351F16);
    border: 1.5px solid var(--border-color, #DDD3CB);
    padding: 12px 28px;
    border-radius: 6px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .btn-orders:hover {
    background-color: var(--bg-warm, #DDD3CB);
    color: var(--text-color, #351F16);
  }
</style>

<div class="order-failure-section">
  <div class="container">
    <div class="order-failure-box">
      <div class="failure-icon-wrap">
        <i class="bx bx-x"></i>
      </div>
      
      <h2>Payment Was Unsuccessful</h2>
      <p class="failure-message">
        We could not complete your payment transaction. Do not worry — your selected items and order record are safely preserved. You can retry with Razorpay or use an alternative payment option.
      </p>
      
      <div class="order-id-badge">
        Order ID: #<%= order.orderNumber %>
      </div>
      
      <div class="action-buttons-wrap">
        <button onclick="retryPayment('<%= order._id %>', '<%= order.orderAmount %>')" class="btn-retry">
          <i class="bx bx-refresh"></i>
          <span>Retry Payment</span>
        </button>
        
        <a href="/orders" class="btn-orders">
          <span>View Orders</span>
          <i class="bx bx-list-ul"></i>
        </a>
      </div>
    </div>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
function retryPayment(orderId, amount) {
  fetch('/retry-payment', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ 
      orderId: orderId,
      amount: parseFloat(amount) * 100
    })
  })
  .then(response => response.json())
  .then(order => {
    const options = {
      key: order.key_id,
      amount: order.amount,
      currency: order.currency,
      name: 'Attrio Fashions',
      description: 'Order Payment Retry',
      order_id: order.id,
      handler: function (response) {
        updateOrderPayment(orderId, response.razorpay_payment_id, response.razorpay_order_id);
      },
      theme: {
        color: '#4B4C3C'
      }
    };

    const rzp = new Razorpay(options);
    rzp.open();
  })
  .catch(error => {
    console.error('Error:', error);
    Swal.fire({
      title: 'Error',
      text: 'Failed to initiate payment retry. Please try again later.',
      icon: 'error',
      confirmButtonColor: '#4B4C3C'
    });
  });
}

function updateOrderPayment(orderId, paymentId, razorpayOrderId) {
  fetch('/update-payment-status', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      orderId: orderId,
      paymentId: paymentId,
      razorpayOrderId: razorpayOrderId
    })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      window.location.href = '/placeorder?id=' + orderId;
    } else {
      Swal.fire({
        title: 'Error',
        text: 'Payment update could not be verified.',
        icon: 'error',
        confirmButtonColor: '#4B4C3C'
      });
    }
  });
}
</script>

<%- include('../partials/user/footer') %>
