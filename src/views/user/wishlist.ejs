<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/user/assets/css/cartstyle.css">

<style>
.wishlist-table-container {
  background-color: #FFFFFF;
  border-radius: 12px;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  padding: 30px;
}

.wishlist-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 16px;
}

.wishlist-header h3 {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 600;
  color: var(--text-heading);
  margin-bottom: 0;
  display: flex;
  align-items: center;
  gap: 10px;
}

.wishlist-header h3 i {
  color: var(--accent);
}

.action-buttons {
  display: flex;
  justify-content: center;
  gap: 8px;
}

.add-to-cart-btn, .remove-btn {
  width: 38px;
  height: 38px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  cursor: pointer;
  transition: all 0.2s;
  background-color: var(--bg-primary);
  color: var(--text-primary);
}

.add-to-cart-btn {
  background-color: var(--btn-primary);
  border-color: var(--btn-primary);
  color: #FFFFFF;
}

.add-to-cart-btn:hover {
  background-color: var(--btn-hover);
  color: #FFFFFF;
}

.add-to-cart-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.remove-btn:hover {
  background-color: var(--danger-light);
  border-color: var(--danger);
  color: var(--danger);
}

.size-option-btn {
  min-width: 45px;
  height: 45px;
  border: 1px solid var(--border);
  background-color: var(--bg-primary);
  border-radius: 6px;
  color: var(--text-primary);
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-right: 8px;
  margin-bottom: 8px;
}

.size-option-btn:hover {
  border-color: var(--accent);
}

.size-option-btn.selected {
  background-color: var(--btn-primary);
  color: #FFFFFF;
  border-color: var(--btn-primary);
}
</style>

<!-- Start Page Title -->
<div class="page-title-area">
  <div class="container">
    <div class="page-title-content">
      <h2>Wishlist</h2>
      <ul>
        <li><a href="/">Home</a></li>
        <li>Wishlist</li>
      </ul>
    </div>
  </div>
</div>
<!-- End Page Title -->

<!-- Start Wishlist Area -->
<section class="wishlist-area" style="padding: 60px 0; background-color: var(--bg-primary);">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <form>
          <div class="wishlist-table-container">
            <div class="wishlist-header">
              <div>
                <h3><i class='bx bx-heart'></i> Your Saved Items</h3>
                <p class="items-count mb-0" style="color: var(--accent); font-size: 14px;">
                  <% if (wishlist && wishlist.items && wishlist.items.length > 0) { %>
                    <%= wishlist.items.length %> item<%= wishlist.items.length > 1 ? 's' : '' %> in your wishlist
                  <% } else { %>
                    0 items saved
                  <% } %>
                </p>
              </div>
              <% if (wishlist && wishlist.items && wishlist.items.length > 0) { %>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearWishlist()">
                  <i class="bx bx-trash me-1"></i> Clear Wishlist
                </button>
              <% } %>
            </div>
            
            <div class="cart-table table-responsive">
              <table class="table table-spaced mb-0">
                <% if (wishlist && wishlist.items && wishlist.items.length > 0) { %>
                <thead>
                  <tr>
                    <th scope="col" style="width: 50px;">#</th>
                    <th scope="col">Product</th>
                    <th scope="col">Price</th>
                    <th scope="col">Status</th>
                    <th scope="col" style="width: 120px;" class="text-center">Actions</th>
                  </tr>
                </thead>

                <tbody>
                    <% wishlist.items.forEach((item, index) => { %>
                      <tr class="cart-item">
                        <td>
                          <span style="color: var(--accent); font-weight: 600;"><%= index + 1 %></span>
                        </td>
                        <td class="product-col">
                          <div class="product-info">
                            <div class="product-image">
                              <a href="/shop-single/<%= item.productId?._id %>">
                                <img src="/<%= item.productId?.image[0] %>" alt="<%= item.productId?.name %>" class="img-fluid">
                              </a>
                            </div>
                            <div class="product-details">
                              <h4 class="product-title">
                                <a href="/shop-single/<%= item.productId?._id %>"><%= item.productId?.name %></a>
                              </h4>
                              <div class="product-meta">
                                <% if (item.size) { %>
                                  <span class="size-badge">Size: <strong><%= item?.size %></strong></span>
                                <% } %>
                                <span style="font-size: 12px; color: var(--accent-light);">Added: <%= new Date(item.dateAdded).toLocaleDateString() %></span>
                              </div>
                            </div>
                          </div>
                        </td>

                        <td class="price-col">
                          <span style="color: var(--text-heading); font-weight: 700; font-size: 15px;">
                            Rs.<%= item.productId?.price.toLocaleString() %>
                          </span>
                        </td>

                        <td class="stock-col">
                          <% if (item.productId?.totalstock > 0) { %>
                            <span class="stock-badge in-stock">In Stock</span>
                          <% } else { %>
                            <span class="stock-badge out-stock">Out of Stock</span>
                          <% } %>
                        </td>
                        
                        <td class="action-col">
                          <div class="action-buttons">
                            <button type="button" class="add-to-cart-btn" onclick="addToCart('<%= item?.productId?._id %>')" <%= item.productId?.totalstock <= 0 ? 'disabled' : '' %> title="Add to Cart">
                              <i class="bx bx-cart-add"></i>
                            </button>
                            <button type="button" class="remove-btn" onclick="removeFromWishlist('<%= item.productId?._id %>')" title="Remove">
                              <i class="bx bx-trash"></i>
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="5">
                        <div class="empty-cart">
                          <div class="empty-cart-icon">
                            <i class="bx bx-heart"></i>
                          </div>
                          <h3>Your wishlist is empty</h3>
                          <p>Save items you love for later or browse our newest collection.</p>
                          <a href="/shop" class="btn-shop-now">
                            <span>Discover Products</span>
                            <i class="bx bx-right-arrow-alt"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <% if (wishlist && wishlist.items && wishlist.items.length > 0) { %>
              <div class="cart-actions">
                <div class="continue-shopping">
                  <a href="/shop" class="btn-continue">
                    <i class="bx bx-chevron-left"></i>
                    <span>Continue Shopping</span>
                  </a>
                </div>
              </div>
            <% } %>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Size Selection Modal -->
<div class="modal fade" id="sizeSelectionModal" tabindex="-1" role="dialog" aria-labelledby="sizeSelectionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content" style="border: 1px solid var(--border); border-radius: 12px;">
      <div class="modal-header" style="border-bottom: 1px solid var(--border); padding: 20px;">
        <h5 class="modal-title font-weight-bold" id="sizeSelectionModalLabel" style="font-family: var(--font-display); color: var(--text-heading);">Select Size</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div class="product-summary mb-4 pb-3" style="border-bottom: 1px solid var(--border-light);">
          <div class="d-flex align-items-center gap-3">
            <div class="product-thumbnail">
              <img id="modalProductImage" src="" alt="Product" class="rounded" style="width: 80px; height: 90px; object-fit: cover;">
            </div>
            <div>
              <h6 id="modalProductName" class="font-weight-bold mb-1" style="color: var(--text-heading);"></h6>
              <p id="modalProductPrice" class="font-weight-bold mb-0" style="color: var(--accent); font-size: 16px;"></p>
            </div>
          </div>
        </div>
        
        <div class="size-selection" id="pSize">
          <label class="form-label" style="font-size: 12px; color: var(--accent); font-weight: 600; text-transform: uppercase;">Available Sizes</label>
          <div class="size-options d-flex flex-wrap mt-2">
            <!-- Populated via JS -->
          </div>
          
          <div id="stockInfo" class="mt-3 p-3 rounded" style="display: none; background: var(--bg-primary);">
            <div class="d-flex align-items-center gap-2">
              <i class="bx bx-package text-muted"></i>
              <span id="stockMessage" class="fw-semibold small"></span>
            </div>
          </div>
          
          <small id="sizeHelper" class="text-muted d-block mt-2">Select a size to view availability</small>
        </div>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--border); padding: 16px 20px;">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="default-btn btn-sm" id="confirmAddToCart" disabled>Add to Cart</button>
      </div>
    </div>
  </div>
</div>

<script>
let currentProductId = null;
let selectedSize = null;

function addToCart(productId) {
  fetch(`/addingtocart/${productId}`)
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        const product = data.product;
        currentProductId = productId;
        
        document.getElementById('modalProductName').textContent = product.name;
        document.getElementById('modalProductPrice').textContent = `Rs.${product.price.toLocaleString()}`;
        document.getElementById('modalProductImage').src = `/${product.image[0]}`;
        
        const sizeOptionsContainer = document.querySelector('.size-options');
        sizeOptionsContainer.innerHTML = '';
        
        selectedSize = null;
        document.getElementById('confirmAddToCart').disabled = true;
        document.getElementById('stockInfo').style.display = 'none';
        document.getElementById('sizeHelper').textContent = 'Select a size to view availability';
        
        if (product.stock && product.stock.length > 0) {
          product.stock.forEach(item => {
            const sizeBtn = document.createElement('button');
            sizeBtn.type = 'button';
            sizeBtn.className = 'size-option-btn';
            sizeBtn.setAttribute('data-size', item.size);
            sizeBtn.setAttribute('data-stock', item.quantity);
            sizeBtn.textContent = item.size;
            
            sizeBtn.addEventListener('click', function() {
              document.querySelectorAll('.size-option-btn').forEach(btn => {
                btn.classList.remove('selected');
              });
              
              this.classList.add('selected');
              selectedSize = this.getAttribute('data-size');
              const stockQty = parseInt(this.getAttribute('data-stock'));
              
              const stockInfo = document.getElementById('stockInfo');
              const stockMessage = document.getElementById('stockMessage');
              stockInfo.style.display = 'block';
              
              if (stockQty > 5) {
                stockMessage.style.color = 'var(--success)';
                stockMessage.textContent = `In stock (${stockQty} available)`;
              } else if (stockQty > 0) {
                stockMessage.style.color = 'var(--warning)';
                stockMessage.textContent = `Low stock: Only ${stockQty} left!`;
              } else {
                stockMessage.style.color = 'var(--danger)';
                stockMessage.textContent = 'Out of stock';
                document.getElementById('confirmAddToCart').disabled = true;
                return;
              }
              
              document.getElementById('confirmAddToCart').disabled = stockQty <= 0;
              document.getElementById('sizeHelper').textContent = `Size ${selectedSize} selected`;
            });
            
            sizeOptionsContainer.appendChild(sizeBtn);
          });
        }
        
        const myModal = new bootstrap.Modal(document.getElementById('sizeSelectionModal'));
        myModal.show();
      } else {
        Swal.fire({
          title: 'Error',
          text: 'Could not retrieve product details.',
          icon: 'error',
          confirmButtonColor: '#4B4C3C',
        });
      }
    })
    .catch(error => {
      console.error('Error:', error);
      Swal.fire({
        title: 'Error',
        text: 'An error occurred.',
        icon: 'error',
        confirmButtonColor: '#4B4C3C',
      });
    });
}

document.getElementById('confirmAddToCart').addEventListener('click', function() {
  if (currentProductId && selectedSize) {
    processAddToCart(currentProductId, selectedSize);
    const modalEl = document.getElementById('sizeSelectionModal');
    const modalInstance = bootstrap.Modal.getInstance(modalEl);
    if (modalInstance) modalInstance.hide();
  }
});

function processAddToCart(productId, size) {
  fetch('/addTocart/', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      productId: productId,
      size: size,
      quantity: 1,
      fromWishlist: true
    })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      Swal.fire({
        title: 'Added to Cart',
        text: 'Item has been added to your shopping cart',
        icon: 'success',
        confirmButtonColor: '#4B4C3C'
      }).then(() => {
        location.reload();
      });
    } else {
      Swal.fire({
        title: 'Error',
        text: data.message || 'Could not add product to cart',
        icon: 'error',
        confirmButtonColor: '#4B4C3C'
      });
    }
  })
  .catch(error => {
    console.error('Error:', error);
  });
}

function removeFromWishlist(productId) {
  Swal.fire({
    title: 'Remove item?',
    text: 'Do you want to remove this item from your wishlist?',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#4B4C3C',
    cancelButtonColor: '#A94442',
    confirmButtonText: 'Remove',
    cancelButtonText: 'Cancel'
  }).then((result) => {
    if (result.isConfirmed) {
      fetch(`/removewishlist/${productId}`, {
        method: 'DELETE'
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload();
        } else {
          Swal.fire({
            title: 'Error',
            text: data.message || 'Failed to remove from wishlist',
            icon: 'error',
            confirmButtonColor: '#4B4C3C'
          });
        }
      });
    }
  });
}

function clearWishlist() {
  Swal.fire({
    title: 'Clear entire wishlist?',
    text: 'All saved items will be removed.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#4B4C3C',
    cancelButtonColor: '#A94442',
    confirmButtonText: 'Clear',
    cancelButtonText: 'Cancel'
  }).then((result) => {
    if (result.isConfirmed) {
      fetch('/clearwishlist', {
        method: 'DELETE'
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload();
        }
      });
    }
  });
}
</script>

<%- include('../partials/user/footer') %>
