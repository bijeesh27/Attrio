<%- include('../partials/user/header') %>

<style>
  .about-hero {
    background: linear-gradient(135deg, var(--bg-warm, #DDD3CB) 0%, var(--bg-primary, #F4F4F4) 100%);
    padding: 70px 0 50px;
    border-bottom: 1px solid var(--border-color, #e2ded9);
    text-align: center;
  }

  .about-hero h1 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 2.8rem;
    color: var(--text-color, #351F16);
    margin-bottom: 14px;
    letter-spacing: -0.5px;
  }

  .about-hero p {
    font-size: 1.1rem;
    color: var(--text-muted, #7c7267);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .about-content-section {
    padding: 70px 0;
  }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 50px;
    align-items: center;
    margin-bottom: 70px;
  }

  .story-text h2 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 2.2rem;
    color: var(--text-color, #351F16);
    margin-bottom: 18px;
  }

  .story-text p {
    color: #605249;
    line-height: 1.8;
    font-size: 1rem;
    margin-bottom: 20px;
  }

  .story-image-wrap {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(53, 31, 22, 0.08);
    border: 1px solid var(--border-color, #DDD3CB);
    background-color: var(--bg-warm, #DDD3CB);
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .story-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .values-section {
    background-color: #FFFFFF;
    border: 1px solid var(--border-color, #DDD3CB);
    border-radius: 12px;
    padding: 50px 40px;
    margin-bottom: 60px;
  }

  .values-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .values-header h2 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 2rem;
    color: var(--text-color, #351F16);
    margin-bottom: 10px;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .value-card {
    text-align: center;
    padding: 24px;
    border-radius: 8px;
    background-color: var(--bg-primary, #F4F4F4);
    border: 1px solid var(--border-color, #DDD3CB);
  }

  .value-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--bg-warm, #DDD3CB);
    color: var(--accent, #967565);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    margin-bottom: 18px;
  }

  .value-card h3 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 1.25rem;
    color: var(--text-color, #351F16);
    margin-bottom: 10px;
  }

  .value-card p {
    font-size: 0.92rem;
    color: #605249;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 991px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }
    .values-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>

<div class="about-hero">
  <div class="container">
    <h1>The Attrio Story</h1>
    <p>Crafting timeless contemporary silhouettes with sustainable textiles and artisanal care.</p>
  </div>
</div>

<div class="about-content-section">
  <div class="container">
    <!-- Story Block -->
    <div class="story-grid">
      <div class="story-text">
        <h2>Heritage & Modern Elegance</h2>
        <p>
          Founded on the philosophy of understated luxury, Attrio is dedicated to redefining essential apparel through quiet sophistication, earth-inspired palettes, and uncompromising craftsmanship.
        </p>
        <p>
          Each garment begins with thoughtfully sourced sustainable fibers — organic linens, fine wools, and breathable cottons tailored to seamlessly accompany you through every chapter of modern life.
        </p>
        <a href="/shop" class="btn" style="background-color: var(--btn-primary, #4B4C3C); color: #FFF; padding: 12px 28px; font-weight: 500; border-radius: 6px;">
          Discover Collection
        </a>
      </div>
      <div class="story-image-wrap">
        <img src="/user/assets/img/women-banner.jpg" alt="Attrio Craftsmanship" onerror="this.onerror=null; this.src='/user/assets/images/about-img.jpg';" />
      </div>
    </div>

    <!-- Core Values -->
    <div class="values-section">
      <div class="values-header">
        <h2>Our Core Pillars</h2>
        <p class="text-muted">The principles guiding every stitch, silhouette, and client experience.</p>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon"><i class="bx bx-feather"></i></div>
          <h3>Artisanal Precision</h3>
          <p>Meticulous attention to seamwork, drapery, and structured tailoring that elevates everyday attire.</p>
        </div>

        <div class="value-card">
          <div class="value-icon"><i class="bx bx-globe"></i></div>
          <h3>Conscious Living</h3>
          <p>Ethical manufacturing partnerships and sustainable textiles that honor both craftspeople and environment.</p>
        </div>

        <div class="value-card">
          <div class="value-icon"><i class="bx bx-heart"></i></div>
          <h3>Timeless Vision</h3>
          <p>Enduring silhouettes designed to outlive ephemeral trends and remain essential wardrobe staples.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/user/footer') %>
