<%- include('../partials/user/header') %>

<style>
  /* Home Page Styling - Attiro Design System */
  .hero-banner {
    position: relative;
    background-color: var(--bg-warm);
    padding: 80px 0;
    overflow: hidden;
  }

  .main-banner-content .sub-title {
    display: inline-block;
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 12px;
  }

  .main-banner-content h1 {
    font-family: var(--font-display);
    font-size: 54px;
    font-weight: 700;
    color: var(--text-heading);
    line-height: 1.15;
    margin-bottom: 18px;
  }

  .main-banner-content p {
    font-size: 16px;
    color: var(--text-primary);
    margin-bottom: 30px;
    max-width: 480px;
  }

  .banner-image {
    text-align: center;
    position: relative;
  }

  .banner-image img {
    max-height: 480px;
    object-fit: contain;
  }

  /* Category Banners */
  .categories-banner-area {
    padding: 70px 0 40px;
  }

  .single-categories-box {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 30px;
    box-shadow: var(--shadow-sm);
  }

  .single-categories-box img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .single-categories-box:hover img {
    transform: scale(1.04);
  }

  .single-categories-box .content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px;
    background: linear-gradient(to top, rgba(53, 31, 22, 0.85) 0%, rgba(53, 31, 22, 0.2) 70%, transparent 100%);
    color: #FFFFFF;
  }

  .single-categories-box .content span {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #DDD3CB;
  }

  .single-categories-box .content h3 {
    font-family: var(--font-display);
    font-size: 24px;
    color: #FFFFFF;
    margin: 6px 0 16px;
  }

  .single-categories-box .content .default-btn {
    padding: 8px 20px;
    font-size: 13px;
    background-color: #FFFFFF !important;
    color: var(--btn-primary) !important;
    border: none !important;
  }

  .single-categories-box .content .default-btn:hover {
    background-color: var(--bg-warm) !important;
  }

  /* Search & Filter Styling */
  .search-container {
    display: flex;
    justify-content: center;
    margin: 30px 0;
  }

  .search-form {
    position: relative;
    width: 100%;
    max-width: 500px;
  }

  .search-input {
    width: 100%;
    height: 48px;
    padding: 10px 48px 10px 18px;
    border: 1px solid var(--border);
    border-radius: 24px;
    background-color: #FFFFFF;
    font-size: 14px;
  }

  .search-input:focus {
    border-color: var(--accent);
    outline: none;
    box-shadow: 0 0 0 3px rgba(150, 117, 101, 0.15);
  }

  .search-button {
    position: absolute;
    right: 6px;
    top: 6px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--btn-primary);
    color: #FFFFFF;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<body>
  <% if (error_msg && error_msg.length > 0) { %>
  <div class="flash-message error-message" id="flash-message">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-alert-circle">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span><%= error_msg %></span>
  </div>
  <% } %> 
  
  <% if (success_msg && success_msg.length > 0) { %>
  <div class="flash-message success-message" id="flash-message">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check-circle">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span><%= success_msg %></span>
  </div>
  <% } %>

  <!-- Start Main Banner Area -->
  <div class="home-slides-three owl-carousel owl-theme">
    <div class="hero-banner">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <div class="main-banner-content">
              <span class="sub-title">Timeless Luxury Collection</span>
              <h1>Curated Style For Modern Taste</h1>
              <p>Discover hand-crafted silhouettes and elevated essentials designed with understated elegance.</p>
              <div class="btn-box">
                <a href="/shop" class="default-btn">Explore Collection</a>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="banner-image">
              <img src="/user/assets/img/img.png" alt="Attiro Collection" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-banner">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <div class="main-banner-content">
              <span class="sub-title">Seasonal Capsule</span>
              <h1>Understated & Contemporary</h1>
              <p>Refined materials, earthy color palettes, and perfect fits for your everyday wardrobe.</p>
              <div class="btn-box">
                <a href="/shop" class="default-btn">Shop Now</a>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div class="banner-image">
              <img src="/user/assets/img/img2.png" alt="Attiro Seasonal" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- End Main Banner Area -->

  <!-- Start Categories Banner Area -->
  <section class="categories-banner-area">
    <div class="container">
      <div class="section-title">
        <span class="sub-title">Browse By Category</span>
        <h2>Shop The Collections</h2>
      </div>

      <div class="row justify-content-center">
        <% category.forEach(category => { %>
        <div class="col-lg-4 col-md-6 col-sm-6">
          <div class="single-categories-box">
            <% if (category.name=="MEN") { %>
            <img src="/user/assets/img/categories/img10.jpg" alt="Men's Collection" />
            <% } else if (category.name=="KID") { %>
            <img src="/user/assets/img/categories/img2.jpg" alt="Kids' Collection" />
            <% } else if (category.name=="WOMAN") { %>
            <img src="/user/assets/img/categories/img3.jpg" alt="Women's Collection" />
            <% } else if (category.name=="BABY") { %>
            <img src="/user/assets/img/categories/img4.jpg" alt="Baby Collection" />
            <% } else { %>
            <img src="/user/assets/img/categories/img10.jpg" alt="<%= category.name %>" />
            <% } %>
            <div class="content">
              <span><%= category.name %></span>
              <h3><%= category.description %></h3>
              <a href="/catfilter/<%= category._id %>">
                <button class="default-btn">Shop Category</button>
              </a>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <!-- End Categories Banner Area -->

  <!-- Start Products Area -->
  <section class="products-area pb-70">
    <div class="container">
      <div class="section-title">
        <span class="sub-title">Handpicked Essentials</span>
        <h2>Recent Arrivals</h2>
      </div>

      <div id="products-collections-filter" class="row">
        <% products.forEach(product => { %>
        <div class="col-lg-4 col-md-6 col-sm-6 products-col-item">
          <div class="single-productsBox">
            <div class="products-image">
              <a href="/shopsingle/<%= product._id %>">
                <img
                  src="/<%= product.image[0] %>"
                  class="main-image"
                  alt="<%= product.name %>"
                />
                <img
                  src="/<%= product.image[1] %>"
                  class="hover-image"
                  alt="<%= product.name %>"
                />
              </a>

              <div class="products-button">
                <ul>
                  <li>
                    <div
                      class="wishlist-btn"
                      data-product-id="<%= product._id %>"
                    >
                      <a>
                        <% if (wishlistProduct && wishlistProduct.length > 0) {
                          let isInWishlist = false;
                          wishlistProduct.forEach((item) => { 
                            if (item.toString() === product._id.toString()) { 
                              isInWishlist = true; 
                            } 
                          });
                          if (isInWishlist) { %>
                            <i class="bx bxs-heart" style="color: var(--accent);"></i>
                          <% } else { %>
                            <i class="bx bx-heart"></i>
                          <% } %> 
                        <% } else { %>
                          <i class="bx bx-heart"></i>
                        <% } %>
                        <span class="tooltip-label">Wishlist</span>
                      </a>
                    </div>
                  </li>

                  <li>
                    <div class="quick-view-btn">
                      <a
                        href="#"
                        data-bs-toggle="modal"
                        data-bs-target="#productsQuickView"
                        data-product-id="<%= product._id %>"
                      >
                        <i class="bx bx-search-alt"></i>
                        <span class="tooltip-label">Quick View</span>
                      </a>
                    </div>
                  </li>
                </ul>
              </div>

              <% if (product.createdAt) { 
                const createdAtDate = new Date(product.createdAt); 
                const fiveDaysAgo = new Date();
                fiveDaysAgo.setDate(fiveDaysAgo.getDate() - 5); 
                if (createdAtDate >= fiveDaysAgo) { %>
                <div class="new-tag">New</div>
              <% } } %>
            </div>

            <div class="products-content">
              <div class="size-selection mb-2">
                <div class="size-buttons">
                  <button type="button" class="size-btn">S</button>
                  <button type="button" class="size-btn">M</button>
                  <button type="button" class="size-btn">L</button>
                  <button type="button" class="size-btn">XL</button>
                </div>
              </div>

              <h3>
                <a href="/shopsingle/<%= product._id %>"><%= product.name %></a>
              </h3>

              <div class="star-rating">
                <% for(let i = 1; i <= 5; i++) { %>
                <i
                  class="bx <%= i <= Math.round(product.averageRating || 0) ? 'bxs-star' : 'bx-star' %>"
                ></i>
                <% } %>
              </div>

              <div class="price">
                <% if (product.discountedPrice) { %>
                <span class="old-price">Rs.<%= product.originalPrice %></span>
                <span class="new-price">Rs.<%= product.discountedPrice %></span>
                <% } else { %>
                <span class="new-price">Rs.<%= product.price %></span>
                <% } %>
              </div>

              <a
                href="#"
                class="add-to-cart"
                data-product-id="<%= product._id %>"
                data-product-name="<%= product.name %>"
              >
                Add to Cart
              </a>
            </div>

            <% if (product.discountedPrice) { %>
            <span class="products-discount">
              <span><%= product.discountPercentage %>% OFF</span>
            </span>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>
  <!-- End Products Area -->

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
  <div class="pagination-area text-center mb-5">
    <div class="pagination-container">
      <div class="pagination-numbers">
        <a
          href="?page=<%= currentPage > 1 ? currentPage - 1 : 1 %>"
          class="pagination-arrow prev <%= currentPage === 1 ? 'disabled' : '' %>"
        >
          <i class="bx bx-chevron-left"></i>
        </a>

        <% const maxPagesToShow = 5; 
           let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2)); 
           let endPage = Math.min(totalPages, startPage + maxPagesToShow - 1); 
           if (endPage - startPage + 1 < maxPagesToShow) { 
             startPage = Math.max(1, endPage - maxPagesToShow + 1); 
           } 
           if (startPage > 1) { %>
          <a href="?page=1" class="pagination-number">1</a>
          <% if (startPage > 2) { %>
            <span class="pagination-ellipsis px-2" style="color: var(--accent);">...</span>
          <% } %> 
        <% } %> 

        <% for(let i = startPage; i <= endPage; i++) { %> 
          <% if(i === currentPage) { %>
            <span class="pagination-number active"><%= i %></span>
          <% } else { %>
            <a href="?page=<%= i %>" class="pagination-number"><%= i %></a>
          <% } %> 
        <% } %> 

        <% if (endPage < totalPages) { %> 
          <% if (endPage < totalPages - 1) { %>
            <span class="pagination-ellipsis px-2" style="color: var(--accent);">...</span>
          <% } %>
          <a href="?page=<%= totalPages %>" class="pagination-number"><%= totalPages %></a>
        <% } %>

        <a
          href="?page=<%= currentPage < totalPages ? currentPage + 1 : totalPages %>"
          class="pagination-arrow next <%= currentPage === totalPages ? 'disabled' : '' %>"
        >
          <i class="bx bx-chevron-right"></i>
        </a>
      </div>

      <div class="pagination-info">
        Showing page <%= currentPage %> of <%= totalPages %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Start QuickView Modal Area -->
  <div
    class="modal fade productsQuickView"
    id="productsQuickView"
    tabindex="-1"
    role="dialog"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
      <div class="modal-content" style="border-radius: 12px; border: 1px solid var(--border); overflow: hidden;">
        <button
          type="button"
          class="close"
          data-bs-dismiss="modal"
          aria-label="Close"
          style="position: absolute; right: 18px; top: 18px; z-index: 10; border: none; background: transparent; font-size: 24px; color: var(--text-primary);"
        >
          <span aria-hidden="true"><i class="bx bx-x"></i></span>
        </button>

        <div id="quickViewContent" class="p-4">
          <!-- Loaded via AJAX -->
        </div>
      </div>
    </div>
  </div>
  <!-- End QuickView Modal Area -->

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      removeFlashMessage();
      initQuickView();
      initWishlistButtons();
      initAddToCartButtons();

      const sizeButtons = document.querySelectorAll(".size-btn");
      sizeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const parentGroup = button.closest(".size-buttons");
          parentGroup.querySelectorAll(".size-btn").forEach((btn) => {
            btn.classList.remove("selected");
          });
          button.classList.add("selected");
        });
      });
    });

    function removeFlashMessage() {
      const flashMessage = document.getElementById("flash-message");
      if (flashMessage) {
        setTimeout(() => {
          flashMessage.style.opacity = "0";
          setTimeout(() => flashMessage.remove(), 300);
        }, 2500);
      }
    }

    function initQuickView() {
      const quickViewBtns = document.querySelectorAll(".quick-view-btn a");
      const quickViewContent = document.getElementById("quickViewContent");

      quickViewBtns.forEach((btn) => {
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          const productId = this.getAttribute("data-product-id");

          quickViewContent.innerHTML = '<div class="text-center py-5"><i class="bx bx-loader bx-spin fs-1" style="color: var(--accent);"></i></div>';

          fetch(`/singleproduct/${productId}`)
            .then((response) => response.json())
            .then((data) => {
              if (data.success) {
                const product = data.product;
                const quickViewHTML = `
                  <div class="row align-items-center">
                    <div class="col-lg-6 col-md-6 mb-3 mb-md-0">
                      <div class="products-image text-center bg-light rounded p-2">
                        <img src="/${product.image[0]}" alt="${product.name}" class="img-fluid rounded" style="max-height: 380px; object-fit: contain;">
                      </div>
                    </div>

                    <div class="col-lg-6 col-md-6">
                      <div class="products-content">
                        <h3 class="mb-2" style="font-family: var(--font-display);"><a href="/shopsingle/${product._id}">${product.name}</a></h3>

                        <div class="price mb-3">
                          <span class="new-price" style="font-size: 22px; font-weight: 700; color: var(--text-heading);">Rs.${product.price}</span>
                        </div>

                        <ul class="products-info list-unstyled mb-3">
                          <li class="small text-muted mb-1">
                            <span>Availability:</span> 
                            <strong style="color: ${product.totalstock > 0 ? 'var(--success)' : 'var(--danger)'}">
                              ${product.totalstock > 0 ? `In stock (${product.totalstock} items)` : 'Out of stock'}
                            </strong>
                          </li>
                        </ul>

                        <div class="d-flex align-items-center gap-3 mb-4">
                          <div class="quantity-selector">
                            <button type="button" class="quantity-btn minus-btn"><i class="bx bx-minus"></i></button>
                            <input type="text" value="1" id="quickQuantity" class="quantity-input" readonly>
                            <button type="button" class="quantity-btn plus-btn"><i class="bx bx-plus"></i></button>
                          </div>

                          <button type="button" class="default-btn add-to-cart-quick" data-product-id="${product._id}">
                            Add to Cart
                          </button>
                        </div>

                        <a href="/shopsingle/${product._id}" style="color: var(--accent); font-weight: 500; font-size: 14px;">
                          View Full Product Details <i class="bx bx-right-arrow-alt"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                `;
                quickViewContent.innerHTML = quickViewHTML;

                const qMinus = quickViewContent.querySelector(".minus-btn");
                const qPlus = quickViewContent.querySelector(".plus-btn");
                const qInput = quickViewContent.querySelector("#quickQuantity");
                if (qMinus && qPlus && qInput) {
                  qMinus.onclick = () => { if (parseInt(qInput.value) > 1) qInput.value = parseInt(qInput.value) - 1; };
                  qPlus.onclick = () => { qInput.value = parseInt(qInput.value) + 1; };
                }
              } else {
                quickViewContent.innerHTML = '<p class="text-center py-4">Product details not found.</p>';
              }
            })
            .catch(() => {
              quickViewContent.innerHTML = '<p class="text-center py-4">Error loading product details.</p>';
            });
        });
      });
    }

    function initAddToCartButtons() {
      const addToCartButtons = document.querySelectorAll(".add-to-cart");

      addToCartButtons.forEach((button) => {
        button.addEventListener("click", function (e) {
          e.preventDefault();
          const productBox = this.closest(".single-productsBox");
          const productId = productBox.querySelector(".wishlist-btn").getAttribute("data-product-id");
          const selectedSizeButton = productBox.querySelector(".size-btn.selected");

          if (!selectedSizeButton) {
            showNotification("error", "Please select a size first");
            return;
          }

          const selectedSize = selectedSizeButton.textContent;
          this.innerHTML = '<i class="bx bx-loader bx-spin"></i> Adding...';

          fetch("/addTocart", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ productId, size: selectedSize, quantity: 1 }),
          })
            .then((response) => response.json())
            .then((data) => {
              this.innerHTML = "Add to Cart";
              if (data.success) {
                showNotification("success", "Product added to cart");
                const cartCount = document.querySelector(".cart-btn a span");
                if (cartCount && data.cartCount !== undefined) {
                  cartCount.textContent = data.cartCount;
                }
              } else {
                if (data.login_required) {
                  window.location.href = "/login?redirect=" + encodeURIComponent(window.location.href);
                } else {
                  showNotification("error", data.message || "Failed to add to cart");
                }
              }
            })
            .catch(() => {
              this.innerHTML = "Add to Cart";
              showNotification("error", "Failed to add to cart");
            });
        });
      });
    }

    function initWishlistButtons() {
      const wishlistBtns = document.querySelectorAll(".wishlist-btn");

      wishlistBtns.forEach((btn) => {
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          const productId = this.getAttribute("data-product-id");
          const icon = this.querySelector("i");
          icon.className = "bx bx-loader bx-spin";

          fetch("/addtowishlist", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ productId }),
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.success) {
                icon.className = data.in_wishlist ? "bx bxs-heart" : "bx bx-heart";
                if (data.in_wishlist) {
                  icon.style.color = "var(--accent)";
                  showNotification("success", "Product added to wishlist");
                } else {
                  icon.style.color = "";
                  showNotification("success", "Product removed from wishlist");
                }
              } else {
                icon.className = "bx bx-heart";
                if (data.login_required) {
                  window.location.href = "/login?redirect=" + encodeURIComponent(window.location.href);
                } else {
                  showNotification("error", data.message || "Error updating wishlist");
                }
              }
            })
            .catch(() => {
              icon.className = "bx bx-heart";
              showNotification("error", "Failed to update wishlist");
            });
        });
      });
    }

    function showNotification(type, message) {
      const notification = document.createElement("div");
      notification.className = "notification " + type;
      notification.innerHTML = `<span>${message}</span><button class="close-btn">&times;</button>`;
      document.body.appendChild(notification);

      setTimeout(() => {
        notification.style.opacity = "0";
        setTimeout(() => notification.remove(), 300);
      }, 3000);

      notification.querySelector(".close-btn").addEventListener("click", () => {
        notification.style.opacity = "0";
        setTimeout(() => notification.remove(), 300);
      });
    }
  </script>

  <%- include('../partials/user/footer') %>
</body>
