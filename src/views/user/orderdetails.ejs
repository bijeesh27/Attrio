<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/user/assets/css/profilestyle.css" />

<style>
  .order-detail-card {
    background-color: #FFFFFF;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 15px rgba(53, 31, 22, 0.04);
    overflow: hidden;
  }

  .order-header-pane {
    background: linear-gradient(135deg, var(--bg-warm) 0%, #FFFFFF 100%);
    padding: 24px 28px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
  }

  .order-header-pane h2 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    margin: 0 0 6px 0;
    font-size: 1.6rem;
    color: var(--text-color);
  }

  .order-header-pane p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .order-status-badge {
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: capitalize;
  }

  .order-body-pane {
    padding: 28px;
  }

  .order-summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }

  .summary-box-card {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 20px;
    background-color: #FFFFFF;
  }

  .summary-box-card h3 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    margin: 0 0 14px 0;
    font-size: 1.15rem;
    color: var(--text-color);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-color);
  }

  .summary-box-card p {
    margin: 0 0 8px 0;
    font-size: 0.9rem;
    color: var(--text-color);
  }

  .summary-box-card p span {
    font-weight: 600;
    color: var(--text-muted);
    display: inline-block;
    min-width: 130px;
  }

  /* Timeline */
  .order-timeline-wrap {
    margin: 35px 0 40px;
    position: relative;
    padding-left: 28px;
  }

  .timeline-track-line {
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 9px;
    width: 2px;
    background-color: var(--border-color);
  }

  .timeline-step-item {
    position: relative;
    padding-bottom: 24px;
  }

  .timeline-step-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot-circle {
    position: absolute;
    left: -28px;
    top: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: #FFFFFF;
    border: 2px solid var(--border-color);
    z-index: 1;
    transition: all 0.2s ease;
  }

  .timeline-step-item.completed .timeline-dot-circle {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
  }

  .timeline-content-card {
    background-color: #FAF8F6;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 14px 18px;
  }

  .timeline-content-card .timeline-date {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0 0 4px 0;
  }

  .timeline-content-card h4 {
    margin: 0 0 4px 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-color);
  }

  .timeline-content-card p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  /* Items Table */
  .items-table-wrapper {
    margin-top: 35px;
  }

  .items-table-wrapper h3 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 1.3rem;
    color: var(--text-color);
    margin-bottom: 16px;
  }

  .items-table-clean {
    width: 100%;
    border-collapse: collapse;
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
  }

  .items-table-clean th {
    background-color: var(--bg-warm);
    padding: 12px 16px;
    text-align: left;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--text-color);
    border-bottom: 1px solid var(--border-color);
  }

  .items-table-clean td {
    padding: 16px;
    border-bottom: 1px solid var(--border-color);
    vertical-align: middle;
    font-size: 0.9rem;
  }

  .items-table-clean tr:last-child td {
    border-bottom: none;
  }

  .product-image-thumb {
    width: 54px;
    height: 54px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    margin-right: 14px;
  }

  .btn-sm-action {
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: all 0.2s ease;
  }

  .btn-sm-danger {
    background-color: #fbedeb;
    color: #A34836;
    border: 1px solid #f0d5ce;
  }

  .btn-sm-danger:hover {
    background-color: #A34836;
    color: #FFFFFF;
  }

  .btn-sm-disabled {
    background-color: #e9ecef;
    color: #999;
    cursor: not-allowed;
    border: 1px solid #ddd;
  }

  /* Totals */
  .order-totals-box {
    margin-top: 30px;
    border-top: 1px solid var(--border-color);
    padding-top: 20px;
  }

  .totals-table-clean {
    width: 100%;
    max-width: 360px;
    margin-left: auto;
  }

  .totals-table-clean td {
    padding: 6px 0;
    font-size: 0.92rem;
  }

  .totals-table-clean .grand-total td {
    font-family: var(--font-heading, serif);
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--text-color);
    padding-top: 12px;
    border-top: 2px solid var(--border-color);
  }

  /* Actions footer */
  .order-actions-bar {
    margin-top: 35px;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  /* Modal */
  .return-modal {
    display: none;
    position: fixed;
    z-index: 10000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
  }

  .return-modal-content {
    background-color: #FFFFFF;
    margin: 10% auto;
    padding: 26px;
    border-radius: 10px;
    max-width: 480px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }
</style>

<body>
  <div class="dashboard-container">
    <!-- Account Menu -->
    <div class="account-tabs-menu">
      <ul>
        <li><a href="/profile"><i class="bx bxs-user"></i>Profile</a></li>
        <li><a href="/orders" class="active"><i class="bx bxs-shopping-bag"></i> Orders</a></li>
        <li><a href="/address"><i class="bx bxs-map"></i> Addresses</a></li>
        <li><a href="/wallet"><i class="bx bxs-wallet"></i> Wallet</a></li>
        <li><a href="/changenewpassword"><i class="bx bx-lock-alt"></i> Change Password</a></li>
      </ul>
      <div style="margin-top: 40px;">
        <button onclick="logout()" class="logout-button">
          <i class="bx bx-log-out"></i> Logout
        </button>
      </div>
    </div>

    <!-- Dashboard Content -->
    <div class="dashboard-content">
      <div class="order-detail-card">
        <!-- Header -->
        <div class="order-header-pane">
          <div>
            <h2>Order #<%= order.orderNumber %></h2>
            <p>Placed on <%= new Date(order.createdAt).toLocaleString('en-US', {
              year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'
            }) %></p>
          </div>
          <div>
            <span class="order-status-badge status-<%= order.paymentStatus.toLowerCase() %>">
              Payment: <%= order.paymentStatus %>
            </span>
          </div>
        </div>

        <!-- Body -->
        <div class="order-body-pane">
          <!-- Summaries -->
          <div class="order-summary-grid">
            <!-- Shipping Info -->
            <div class="summary-box-card">
              <h3>Delivery Details</h3>
              <% if(order.deliveryAddress && typeof order.deliveryAddress === 'object') { %>
                <p><strong><%= address[0]?.name || '' %></strong></p>
                <p class="text-muted"><%= address[0]?.houseName || '' %></p>
                <p class="text-muted"><%= address[0]?.city || '' %>, <%= address[0]?.state || '' %> <%= address[0]?.pincode || '' %></p>
                <p class="text-muted"><%= address[0]?.country || 'India' %></p>
                <p>Phone: <strong><%= address[0]?.number || '' %></strong></p>
              <% } else { %>
                <p class="text-muted">Delivery address unavailable</p>
              <% } %>
            </div>

            <!-- Payment Info -->
            <div class="summary-box-card">
              <h3>Payment Summary</h3>
              <p><span>Payment Method:</span> <strong><%= order.paymentMethod %></strong></p>
              <p><span>Payment Status:</span> <%= order.paymentStatus %></p>
              <% if(order.transactionId) { %>
                <p><span>Transaction ID:</span> <%= order.transactionId %></p>
              <% } %>
              <% if(order.couponDiscount) { %>
                <p><span>Coupon Discount:</span> -₹<%= order.couponDiscount.toFixed(2) %></p>
              <% } %>
              <p><span>Order Total:</span> <strong>₹<%= order.orderAmount.toFixed(2) %></strong></p>
            </div>

            <!-- Order Timeline Status Info -->
            <div class="summary-box-card">
              <h3>Fulfillment Status</h3>
              <p><span>Current Stage:</span> <strong><%= order.orderStatus || 'Processing' %></strong></p>
              <% if(order.deliveryDate) { %>
                <p><span>Est. Delivery:</span> <%= new Date(order.deliveryDate).toLocaleDateString() %></p>
              <% } %>
              <% if(order.shippingDate) { %>
                <p><span>Shipped On:</span> <%= new Date(order.shippingDate).toLocaleDateString() %></p>
              <% } %>
            </div>
          </div>

          <!-- Order Status Timeline -->
          <div class="order-timeline-wrap">
            <div class="timeline-track-line"></div>
            
            <div class="timeline-step-item completed">
              <div class="timeline-dot-circle"></div>
              <div class="timeline-content-card">
                <p class="timeline-date"><%= new Date(order.createdAt).toLocaleString() %></p>
                <h4>Order Placed</h4>
                <p>Your order has been verified and registered.</p>
              </div>
            </div>
            
            <% 
              const isProcessing = order.orderedItem.some(item => 
                ['processing', 'shipped', 'delivered'].includes(item.productStatus?.toLowerCase())
              ); 
            %>
            <div class="timeline-step-item <%= isProcessing ? 'completed' : '' %>">
              <div class="timeline-dot-circle"></div>
              <div class="timeline-content-card">
                <h4>Processing</h4>
                <p>Garments are being inspected and tailored for shipment.</p>
              </div>
            </div>
            
            <% 
              const isShipped = order.shippingDate || order.orderedItem.some(item => 
                ['shipped', 'delivered'].includes(item.productStatus?.toLowerCase())
              ); 
            %>
            <div class="timeline-step-item <%= isShipped ? 'completed' : '' %>">
              <div class="timeline-dot-circle"></div>
              <div class="timeline-content-card">
                <h4>Dispatched / Shipped</h4>
                <p>Package dispatched via courier partner.</p>
              </div>
            </div>
            
            <% 
              const isDelivered = order.orderedItem.every(item => item.productStatus?.toLowerCase() === 'delivered');
            %>
            <div class="timeline-step-item <%= isDelivered ? 'completed' : '' %>">
              <div class="timeline-dot-circle"></div>
              <div class="timeline-content-card">
                <h4>Delivered</h4>
                <p>Order safely delivered to recipient address.</p>
              </div>
            </div>
          </div>

          <!-- Order Items Table -->
          <div class="items-table-wrapper table-responsive">
            <h3>Items in this Order</h3>
            <table class="items-table-clean">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Price</th>
                  <th>Qty</th>
                  <th>Status</th>
                  <th>Return</th>
                  <th>Cancel</th>
                  <th class="text-end">Total</th>
                </tr>
              </thead>
              <tbody>
                <% order.orderedItem.forEach((item, index) => { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center">
                        <% if(item.productId && item.productId.image && item.productId.image[0]) { %>
                          <img src="/<%= item.productId.image[0] %>" alt="<%= item.productId.name %>" class="product-image-thumb">
                        <% } %>
                        <div>
                          <strong><%= item.productId?.name || 'Product Item' %></strong>
                          <% if(item.size) { %>
                            <div class="text-muted" style="font-size: 0.8rem;">Size: <%= item.size %></div>
                          <% } %>
                        </div>
                      </div>
                    </td>
                    <td>₹<%= item.productPrice.toFixed(2) %></td>
                    <td><%= item.quantity %></td>
                    <td>
                      <span class="order-status-badge status-<%= (item.productStatus || 'pending').toLowerCase() %>">
                        <%= item.productStatus %>
                      </span>
                    </td>
                    <td>
                      <% if(item.productStatus?.toLowerCase() === 'delivered') { %>
                        <button class="btn-sm-action btn-sm-danger" onclick="openReturnModal('<%= order._id %>', '<%= item.productId._id %>', '<%= index %>')">
                          Return
                        </button>
                      <% } else { %>
                        <span class="btn-sm-action btn-sm-disabled">Return</span>
                      <% } %>
                    </td>
                    <td>
                      <% 
                        const nonCancellable = ['delivered', 'cancelled', 'return approved', 'return requested', 'returned'];
                        if(!nonCancellable.includes(item.productStatus?.toLowerCase())) { 
                      %>
                        <button class="btn-sm-action btn-sm-danger" onclick="confirmCancelItem('<%= order._id %>', '<%= item.productId._id %>', '<%= index %>')">
                          Cancel
                        </button>
                      <% } else { %>
                        <span class="btn-sm-action btn-sm-disabled">Cancel</span>
                      <% } %>
                    </td>
                    <td class="text-end"><strong>₹<%= item.totalProductPrice.toFixed(2) %></strong></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- Totals -->
          <div class="order-totals-box">
            <table class="totals-table-clean">
              <% 
                const subtotal = order.orderedItem.reduce((acc, curr) => acc + curr.totalProductPrice, 0);
              %>
              <tr>
                <td class="text-muted">Subtotal:</td>
                <td class="text-end">₹<%= subtotal.toFixed(2) %></td>
              </tr>
              <% if(order.couponDiscount) { %>
                <tr>
                  <td class="text-muted">Coupon Discount:</td>
                  <td class="text-end text-success">-₹<%= order.couponDiscount.toFixed(2) %></td>
                </tr>
              <% } %>
              <tr class="grand-total">
                <td>Grand Total:</td>
                <td class="text-end">₹<%= order.orderAmount.toFixed(2) %></td>
              </tr>
            </table>
          </div>

          <!-- Actions -->
          <div class="order-actions-bar">
            <a href="/orders" class="cancel-btn">
              &larr; Back to Orders
            </a>
            <% if (order.orderStatus === 'Pending') { %>
              <a class="btn-sm-action btn-sm-danger" style="padding: 10px 20px; font-size: 0.9rem;" href="/cancelorder/<%= order._id %>">
                Cancel Order
              </a>
            <% } %>
            <a href="/invoice/<%= order._id %>" class="save-btn" style="display: inline-flex; align-items: center; gap: 6px;">
              <i class="bx bx-download"></i> View Invoice
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Return Reason Modal -->
  <div id="returnModal" class="return-modal">
    <div class="return-modal-content">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="m-0" style="font-family: var(--font-heading, serif);">Request Return</h4>
        <span class="close-modal" style="font-size: 1.5rem; cursor: pointer;" onclick="closeReturnModal()">&times;</span>
      </div>
      <form id="returnForm" method="POST">
        <input type="hidden" id="orderIdInput" name="orderId">
        <input type="hidden" id="productIdInput" name="productId">
        <input type="hidden" id="itemIndexInput" name="itemIndex">
        
        <div class="mb-3">
          <label class="form-label text-dark fw-medium">Reason for return:</label>
          <textarea id="returnReason" name="returnReason" class="form-control" rows="4" required placeholder="Describe reason (e.g. fit issue, defective fabric)..."></textarea>
        </div>
        
        <div class="d-flex justify-content-end gap-2">
          <button type="button" class="cancel-btn" onclick="closeReturnModal()">Cancel</button>
          <button type="submit" class="save-btn">Submit Request</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function logout() {
      Swal.fire({
        title: 'Sign Out',
        text: 'Do you want to continue to logout?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#4B4C3C',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Logout',
        cancelButtonText: 'Cancel',
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = '/logout';
        }
      });
    }

    const returnModal = document.getElementById('returnModal');
    const returnForm = document.getElementById('returnForm');
    const orderIdInput = document.getElementById('orderIdInput');
    const productIdInput = document.getElementById('productIdInput');
    const itemIndexInput = document.getElementById('itemIndexInput');
    
    function openReturnModal(orderId, productId, itemIndex) {
      returnModal.style.display = 'block';
      orderIdInput.value = orderId;
      productIdInput.value = productId;
      itemIndexInput.value = itemIndex;
      returnForm.action = `/returnorder/${orderId}/${productId}`;
    }
    
    function closeReturnModal() {
      returnModal.style.display = 'none';
      returnForm.reset();
    }
    
    window.onclick = function(event) {
      if (event.target === returnModal) {
        closeReturnModal();
      }
    }

    returnForm.addEventListener('submit', function(event) {
      const returnReason = document.getElementById('returnReason').value;
      if (!returnReason.trim()) {
        event.preventDefault();
        Swal.fire('Notice', 'Please provide a reason for return', 'info');
      }
    });

    function confirmCancelItem(orderId, productId, itemIndex) {
      Swal.fire({
        title: 'Cancel Item?',
        text: 'Do you really want to cancel this item from your order?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#4B4C3C',
        cancelButtonColor: '#A34836',
        confirmButtonText: 'Yes, cancel item',
        cancelButtonText: 'Keep it'
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = `/cancelItem/${orderId}/${productId}`;
        }
      });
    }
  </script>
</body>

<%- include('../partials/user/footer') %>
