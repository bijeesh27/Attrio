<%- include('../partials/user/header') %>
<link rel="stylesheet" href="/user/assets/css/profilestyle.css" />

<body>
  <div class="dashboard-container">
    <!-- Account Menu -->
    <div class="account-tabs-menu">
      <ul>
        <li><a href="/profile"><i class="bx bxs-user"></i>Profile</a></li>
        <li><a href="/orders"><i class="bx bxs-shopping-bag"></i> Orders</a></li>
        <li><a href="/address" class="active"><i class="bx bxs-map"></i> Addresses</a></li>
        <li><a href="/wallet"><i class="bx bxs-wallet"></i>Wallet</a></li>
        <li><a href="/changenewpassword"><i class="bx bx-lock-alt"></i>Change Password</a></li>
      </ul>
      <div style="margin-top: 40px;">
        <button onclick="logout()" class="logout-button">
          <i class="bx bx-log-out"></i> Logout
        </button>
      </div>
    </div>

    <!-- Dashboard Content -->
    <div class="dashboard-content">
      <div class="address-section">
        <div class="section-header">
          <h2>Edit Address</h2>
          <a href="/address" class="btn-back">
            <i class="bx bx-arrow-back"></i> Back to Addresses
          </a>
        </div>

        <% const specificAddress = address.address ? address.address[0] : address; %>
        <form id="editAddressForm" action="/editaddress/<%= specificAddress._id %>" method="POST">
          <input type="hidden" name="id" value="<%= address._id %>">
          
          <div class="form-group">
            <label for="saveAs">Address Type*</label>
            <select id="saveAs" name="saveAs" class="form-control" required>
              <option value="">Select Type</option>
              <option value="Home" <%= specificAddress.saveAs === 'Home' ? 'selected' : '' %>>Home</option>
              <option value="Work" <%= specificAddress.saveAs === 'Work' ? 'selected' : '' %>>Work</option>
              <option value="Other" <%= specificAddress.saveAs === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
          
          <div class="form-group">
            <label for="name">Full Name*</label>
            <input type="text" id="name" name="name" class="form-control" value="<%= specificAddress.name %>">
          </div>
          
          <div class="form-group">
            <label for="email">Email*</label>
            <input type="email" id="email" name="email" class="form-control" value="<%= specificAddress.email %>">
          </div>
          
          <div class="form-group">
            <label for="number">Phone Number*</label>
            <input type="tel" id="number" name="number" class="form-control" value="<%= specificAddress.number %>">
          </div>
          
          <div class="form-group">
            <label for="houseName">House/Apartment Name*</label>
            <input type="text" id="houseName" name="houseName" class="form-control" value="<%= specificAddress.houseName %>">
          </div>
          
          <div class="form-group">
            <label for="street">Street*</label>
            <input type="text" id="street" name="street" class="form-control" value="<%= specificAddress.street %>">
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label for="city">City*</label>
                <input type="text" id="city" name="city" class="form-control" value="<%= specificAddress.city %>">
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label for="state">State/Province*</label>
                <input type="text" id="state" name="state" class="form-control" value="<%= specificAddress.state %>">
              </div>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label for="pincode">Postal/Zip Code*</label>
                <input type="text" id="pincode" name="pincode" class="form-control" value="<%= specificAddress.pincode %>">
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label for="country">Country*</label>
                <input type="text" id="country" name="country" class="form-control" value="<%= specificAddress.country %>">
              </div>
            </div>
          </div>
          
          <div class="form-check my-3">
            <input class="form-check-input" type="checkbox" id="isDefault" name="isDefault" <%= specificAddress.isDefault ? 'checked' : '' %>>
            <label class="form-check-label" for="isDefault" style="cursor: pointer;">Set as default address</label>
          </div>
          
          <div class="form-buttons">
            <a href="/address" class="cancel-btn">
              Cancel
            </a>
            <button type="submit" class="save-btn">
              <i class="bx bx-save me-1"></i> Update Address
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function logout() {
      Swal.fire({
        title: 'Sign Out',
        text: 'Do you want to continue to logout?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#4B4C3C',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Logout',
        cancelButtonText: 'Cancel',
      }).then((result) => {
        if (result.isConfirmed) {
          window.location.href = '/logout';
        }
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('editAddressForm');
      
      function validateName(name) {
        return name.trim().length >= 2 && /^[a-zA-Z\s]+$/.test(name.trim());
      }
      function validateEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim());
      }
      function validatePhone(phone) {
        return /^[\+]?[1-9][\d]{0,10}$/.test(phone.replace(/[\s\-\(\)]/g, ''));
      }
      function validateText(text, minLength = 2) {
        return text.trim().length >= minLength;
      }
      function validatePincode(pincode) {
        return /^[0-9]{4,10}$/.test(pincode.trim());
      }
      
      function showError(field, message) {
        removeError(field);
        const errorDiv = document.createElement('div');
        errorDiv.className = 'error-message';
        errorDiv.style.cssText = 'color: #A34836; font-size: 12px; margin-top: 4px;';
        errorDiv.textContent = message;
        field.parentNode.appendChild(errorDiv);
        field.style.borderColor = '#A34836';
      }
      
      function removeError(field) {
        const existingError = field.parentNode.querySelector('.error-message');
        if (existingError) existingError.remove();
        field.style.borderColor = '';
      }
      
      const nameField = document.getElementById('name');
      const emailField = document.getElementById('email');
      const phoneField = document.getElementById('number');
      const houseNameField = document.getElementById('houseName');
      const streetField = document.getElementById('street');
      const cityField = document.getElementById('city');
      const stateField = document.getElementById('state');
      const pincodeField = document.getElementById('pincode');
      const countryField = document.getElementById('country');
      const saveAsField = document.getElementById('saveAs');

      nameField?.addEventListener('blur', function() {
        if (!validateName(this.value)) showError(this, 'Name must be at least 2 characters and contain only letters');
        else removeError(this);
      });
      emailField?.addEventListener('blur', function() {
        if (!validateEmail(this.value)) showError(this, 'Please enter a valid email address');
        else removeError(this);
      });
      phoneField?.addEventListener('blur', function() {
        if (!validatePhone(this.value)) showError(this, 'Please enter a valid phone number');
        else removeError(this);
      });

      form.addEventListener('submit', function(e) {
        let isValid = true;
        if (!saveAsField.value) { showError(saveAsField, 'Please select an address type'); isValid = false; }
        if (!validateName(nameField.value)) { showError(nameField, 'Valid name is required'); isValid = false; }
        if (!validateEmail(emailField.value)) { showError(emailField, 'Valid email is required'); isValid = false; }
        if (!validatePhone(phoneField.value)) { showError(phoneField, 'Valid phone number is required'); isValid = false; }
        if (!validateText(houseNameField.value)) { showError(houseNameField, 'House/Apartment is required'); isValid = false; }
        if (!validateText(streetField.value)) { showError(streetField, 'Street is required'); isValid = false; }
        if (!validateText(cityField.value)) { showError(cityField, 'City is required'); isValid = false; }
        if (!validateText(stateField.value)) { showError(stateField, 'State is required'); isValid = false; }
        if (!validatePincode(pincodeField.value)) { showError(pincodeField, 'Valid postal code is required'); isValid = false; }
        if (!validateText(countryField.value)) { showError(countryField, 'Country is required'); isValid = false; }

        if (!isValid) {
          e.preventDefault();
          const firstError = document.querySelector('.error-message');
          if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
  </script>
</body>
<%- include('../partials/user/footer') %>
