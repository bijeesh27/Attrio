{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/views/**",
          "public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/admin/assets/(.*)",
      "dest": "/public/admin/assets/$1"
    },
    {
      "src": "/user/assets/(.*)",
      "dest": "/public/user/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
